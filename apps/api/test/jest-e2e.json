{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(xrpl|@xrplf|@noble|@scure|ripple-address-codec|ripple-keypairs|ripple-binary-codec)/)"
  ],
  "moduleNameMapper": {
    "^expo-server-sdk$": "<rootDir>/mocks/expo-server-sdk.js"
  }
}
