  owner           User                @relation("healthPractitionersOwned", fields: [ownerId], references: [id])
  name            String
  specialty       String
  bio             String?
  consultationFee Float
  avatarUrl       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  appointments    HealthAppointment[]
}

model HealthAppointment {
  id             String             @id @default(uuid())
  practitionerId String
  practitioner   HealthPractitioner @relation(fields: [practitionerId], references: [id])
  patientId      String
  patient        User               @relation("healthAppointmentsBooked", fields: [patientId], references: [id])
  scheduledAt    DateTime
  reason         String?
  fee            Float
  status         String             @default("CONFIRMED") // CONFIRMED | COMPLETED | CANCELLED
  createdAt      DateTime           @default(now())
}

model HealthPharmacy {
  id          String                  @id @default(uuid())
  ownerId     String
  owner       User                    @relation("healthPharmaciesOwned", fields: [ownerId], references: [id])
  name        String
  description String?
  logoUrl     String?
  address     String?
  isOpen      Boolean                 @default(true)
  rating      Float                   @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  products    HealthPharmacyProduct[]
  orders      HealthPharmacyOrder[]
}

model HealthPharmacyProduct {
  id                   String                    @id @default(uuid())
  pharmacyId           String
  pharmacy             HealthPharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  price                Float
  imageUrl             String?
  category             String? // 'Medicine' | 'Vitamins' | 'First Aid' | 'Personal Care'
  requiresPrescription Boolean                   @default(false)
  isAvailable          Boolean                   @default(true)
  createdAt            DateTime                  @default(now())
  orderItems           HealthPharmacyOrderItem[]
}

model HealthPharmacyOrder {
  id              String                    @id @default(uuid())
  customerId      String
  customer        User                      @relation("healthPharmacyOrders", fields: [customerId], references: [id])
  pharmacyId      String
  pharmacy        HealthPharmacy            @relation(fields: [pharmacyId], references: [id])
  items           HealthPharmacyOrderItem[]
  status          String                    @default("PLACED") // PLACED | CONFIRMED | READY | COMPLETED | CANCELLED
  subtotal        Float
  total           Float
  deliveryAddress String
  notes           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
}

model HealthPharmacyOrderItem {
  id        String                @id @default(uuid())
  orderId   String
  order     HealthPharmacyOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   HealthPharmacyProduct @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model HealthWellnessPost {
  id          String               @id @default(uuid())
  authorId    String
  author      User                 @relation("healthWellnessPosts", fields: [authorId], references: [id])
  title       String
  description String
  category    String // 'Meditation' | 'Nutrition' | 'Sleep' | 'Exercise' | 'Mental Health'
  imageUrl    String?
  createdAt   DateTime             @default(now())
  likes       HealthWellnessLike[]
}

model HealthWellnessLike {
