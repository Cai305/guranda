// ============================================================
// Finance / Stokvel — member-owned group savings & investment
// circles, each with its own real XRPL multisig wallet. Guranda
// never holds the funds; the committee's on-chain signatures do.
// ============================================================

model Stokvel {
  id          String  @id @default(uuid())
  name        String
  category    String // Savings, Grocery, Building Material, Construction, Business Funding, Franchise Funding, Property Investment, Equipment, Farming, Livestock, School Fees, Funeral Support, Wedding/Event, Church, Taxi Association, or custom
  description String?
  creatorId   String
  creator     User    @relation("stokvelsCreated", fields: [creatorId], references: [id])

  // Governance rules — configured per stokvel at creation
  contributionAmount    Float
  contributionFrequency String // WEEKLY | MONTHLY | QUARTERLY
  joiningFee            Float   @default(0)
  votingThresholdPct    Int     @default(80)
  minMembers            Int     @default(3)
  signerQuorum          Int     @default(2)
  withdrawalRules       String?
  loanRules             String?
  fundingRules          String?
  latePenaltyPct        Float   @default(0)
  approvalWorkflow      String?

  // XRPL multisig wallet — the stokvel's own on-chain account.
  // Once activated, the creator's key is disabled; only a
  // signerQuorum of committee members can move funds.
  xrplAddress         String?
  xrplSeed            String? // custodial, base64 — used only to set up SignerListSet + disable master
  multisigActive      Boolean   @default(false)
  multisigActivatedAt DateTime?

  status String @default("ACTIVE") // ACTIVE | CLOSED

  members       StokvelMember[]
  contributions StokvelContribution[]
  requests      StokvelFundingRequest[]
  auditLogs     StokvelAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StokvelMember {
  id        String   @id @default(uuid())
  stokvelId String
  stokvel   Stokvel  @relation(fields: [stokvelId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("MEMBER") // ADMIN | COMMITTEE | MEMBER
  status    String   @default("ACTIVE") // ACTIVE | REMOVED
  joinedAt  DateTime @default(now())

  contributions StokvelContribution[]
  votes         StokvelVote[]
  signatures    StokvelSignature[]

  @@unique([stokvelId, userId])
}

model StokvelContribution {
  id         String        @id @default(uuid())
  stokvelId  String
  stokvel    Stokvel       @relation(fields: [stokvelId], references: [id])
  memberId   String
  member     StokvelMember @relation(fields: [memberId], references: [id])
  amountXrp  Float
  xrplTxHash String?
  status     String        @default("SUCCESS") // PENDING | SUCCESS | FAILED
  createdAt  DateTime      @default(now())
}

model StokvelFundingRequest {
  id               String  @id @default(uuid())
  stokvelId        String
  stokvel          Stokvel @relation(fields: [stokvelId], references: [id])
  requesterId      String
  requester        User    @relation("stokvelRequestsMade", fields: [requesterId], references: [id])
  title            String
  description      String?
  amountXrp        Float
  recipientAddress String?

  status String @default("VOTING") // VOTING | APPROVED | REJECTED | RELEASED

  // Prepared once voting threshold is reached, so every committee
  // signer signs byte-for-byte the same transaction.
  preparedTx String?

  votes      StokvelVote[]
  signatures StokvelSignature[]

  xrplTxHash String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model StokvelVote {
  id        String                @id @default(uuid())
  requestId String
  request   StokvelFundingRequest @relation(fields: [requestId], references: [id])
  memberId  String
  member    StokvelMember         @relation(fields: [memberId], references: [id])
  choice    String // APPROVE | REJECT
  createdAt DateTime              @default(now())

  @@unique([requestId, memberId])
}

model StokvelSignature {
  id        String                @id @default(uuid())
  requestId String
  request   StokvelFundingRequest @relation(fields: [requestId], references: [id])
  memberId  String
  member    StokvelMember         @relation(fields: [memberId], references: [id])
  txBlob    String
  createdAt DateTime              @default(now())

  @@unique([requestId, memberId])
}

model StokvelAuditLog {
  id        String   @id @default(uuid())
  stokvelId String
  stokvel   Stokvel  @relation(fields: [stokvelId], references: [id])
  actorId   String?
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

// ============================================================
// Learning — courses with lessons/progress/certificates, a
