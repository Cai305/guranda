// ============================================================
// Finance / Stokvel — member-owned group savings & investment
// circles, each with its own real XRPL multisig wallet. Guranda
// never holds the funds; the committee's on-chain signatures do.
// ============================================================

model Stokvel {
  id          String  @id @default(uuid())
  name        String
  category    String // Savings, Grocery, Building Material, Construction, Business Funding, Franchise Funding, Property Investment, Equipment, Farming, Livestock, School Fees, Funeral Support, Wedding/Event, Church, Taxi Association, or custom
  description String?
  creatorId   String
  creator     User    @relation("stokvelsCreated", fields: [creatorId], references: [id])

  // Governance rules — configured per stokvel at creation
  contributionAmount    Float
  contributionFrequency String // WEEKLY | MONTHLY | QUARTERLY
  joiningFee            Float   @default(0)
  votingThresholdPct    Int     @default(80)
  minMembers            Int     @default(3)
  signerQuorum          Int     @default(2)
  withdrawalRules       String?
  loanRules             String?
  fundingRules          String?
  latePenaltyPct        Float   @default(0)
  approvalWorkflow      String?

  // XRPL multisig wallet — the stokvel's own on-chain account.
  // Once activated, the creator's key is disabled; only a
  // signerQuorum of committee members can move funds.
  xrplAddress         String?
  xrplSeed            String? // custodial, base64 — used only to set up SignerListSet + disable master
  multisigActive      Boolean   @default(false)
  multisigActivatedAt DateTime?

  status String @default("ACTIVE") // ACTIVE | CLOSED

  members       StokvelMember[]
  contributions StokvelContribution[]
  requests      StokvelFundingRequest[]
  auditLogs     StokvelAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StokvelMember {
  id        String   @id @default(uuid())
  stokvelId String
  stokvel   Stokvel  @relation(fields: [stokvelId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("MEMBER") // ADMIN | COMMITTEE | MEMBER
  status    String   @default("ACTIVE") // ACTIVE | REMOVED
  joinedAt  DateTime @default(now())

  contributions StokvelContribution[]
  votes         StokvelVote[]
  signatures    StokvelSignature[]

  @@unique([stokvelId, userId])
}

model StokvelContribution {
  id         String        @id @default(uuid())
  stokvelId  String
  stokvel    Stokvel       @relation(fields: [stokvelId], references: [id])
  memberId   String
  member     StokvelMember @relation(fields: [memberId], references: [id])
  amountXrp  Float
  xrplTxHash String?
  status     String        @default("SUCCESS") // PENDING | SUCCESS | FAILED
  createdAt  DateTime      @default(now())
}

model StokvelFundingRequest {
  id               String  @id @default(uuid())
  stokvelId        String
  stokvel          Stokvel @relation(fields: [stokvelId], references: [id])
  requesterId      String
  requester        User    @relation("stokvelRequestsMade", fields: [requesterId], references: [id])
  title            String
  description      String?
  amountXrp        Float
  recipientAddress String?

  status String @default("VOTING") // VOTING | APPROVED | REJECTED | RELEASED

  // Prepared once voting threshold is reached, so every committee
  // signer signs byte-for-byte the same transaction.
  preparedTx String?

  votes      StokvelVote[]
  signatures StokvelSignature[]

  xrplTxHash String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

model StokvelVote {
  id        String                @id @default(uuid())
  requestId String
  request   StokvelFundingRequest @relation(fields: [requestId], references: [id])
  memberId  String
  member    StokvelMember         @relation(fields: [memberId], references: [id])
  choice    String // APPROVE | REJECT
  createdAt DateTime              @default(now())

  @@unique([requestId, memberId])
}

model StokvelSignature {
  id        String                @id @default(uuid())
  requestId String
  request   StokvelFundingRequest @relation(fields: [requestId], references: [id])
  memberId  String
  member    StokvelMember         @relation(fields: [memberId], references: [id])
  txBlob    String
  createdAt DateTime              @default(now())

  @@unique([requestId, memberId])
}

model StokvelAuditLog {
  id        String   @id @default(uuid())
  stokvelId String
  stokvel   Stokvel  @relation(fields: [stokvelId], references: [id])
  actorId   String?
  action    String
  detail    String?
  createdAt DateTime @default(now())
}

// ============================================================
// Voting ("Ballot") — elections for any structure (HOA, company
// board, union, student body, ...). Each structure keeps its own
// voter roll; each election can carry several simultaneous
// ballots (positions), each with its own voting mechanic. Every
// cast vote is recorded on XRPL testnet as a memo-only Payment
// from the voter's personal wallet to the election's ballot-box
// wallet — the memo carries positionId/structureId only, never
// the selection, so the on-chain receipt proves inclusion without
// revealing how anyone voted. Check-ins record that an on-device
// biometric check passed, never any biometric data itself.
// ============================================================

model Structure {
  id            String   @id @default(uuid())
  name          String
  type          String // HOA | CORPORATE | UNION | CLUB | STUDENT_BODY | OTHER
  creatorId     String
  creator       User     @relation("structuresCreated", fields: [creatorId], references: [id])
  createdAt     DateTime @default(now())

  members   StructureMember[]
  elections Election[]
}

model StructureMember {
  id            String   @id @default(uuid())
  structureId   String
  structure     Structure @relation(fields: [structureId], references: [id])
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  role          String    @default("MEMBER") // ADMIN | POLL_WORKER | MEMBER
  votingWeight  Int       @default(1) // shares, for WEIGHTED positions
  status        String    @default("ACTIVE") // ACTIVE | REMOVED
  joinedAt      DateTime  @default(now())

  checkIns ElectionCheckIn[]
  votes    ElectionVote[]

  @@unique([structureId, userId])
}

model Election {
  id                  String    @id @default(uuid())
  structureId         String
  structure           Structure @relation(fields: [structureId], references: [id])
  title               String
  opensAt             DateTime  @default(now())
  closesAt            DateTime?
  status              String    @default("OPEN") // SCHEDULED | OPEN | CLOSED

  // XRPL ballot-box wallet — every cast vote sends a memo-only
  // payment here, giving the election a single publicly auditable
  // on-chain address (mirrors Stokvel.xrplAddress/xrplSeed).
  ballotBoxXrplAddress String?
  ballotBoxXrplSeed    String?

  positions Position[]
  checkIns  ElectionCheckIn[]

  createdAt DateTime @default(now())
}

model ElectionCheckIn {
  id                String          @id @default(uuid())
  electionId        String
  election          Election        @relation(fields: [electionId], references: [id])
  structureMemberId String
  structureMember   StructureMember @relation(fields: [structureMemberId], references: [id])
  method            String // FINGERPRINT | FACE_ID
  verifiedAt        DateTime        @default(now())

  @@unique([electionId, structureMemberId])
}

model Position {
  id         String   @id @default(uuid())
  electionId String
  election   Election @relation(fields: [electionId], references: [id])
  title      String
  votingType String // SINGLE_CHOICE | RANKED_CHOICE | MULTI_SELECT | WEIGHTED
  seats      Int      @default(1)

  candidates Candidate[]
  votes      ElectionVote[]
}

model Candidate {
  id         String   @id @default(uuid())
  positionId String
  position   Position @relation(fields: [positionId], references: [id])
  name       String
  slateName  String?
  colorHex   String?
}

model ElectionVote {
  id                String          @id @default(uuid())
  positionId        String
  position          Position        @relation(fields: [positionId], references: [id])
  structureMemberId String
  structureMember   StructureMember @relation(fields: [structureMemberId], references: [id])

  // Shape depends on Position.votingType — see VotingService for
  // the per-type validation:
  //   SINGLE_CHOICE -> { candidateId }
  //   MULTI_SELECT  -> { candidateIds: string[] }
  //   RANKED_CHOICE -> { rankedCandidateIds: string[] }
  //   WEIGHTED      -> { allocations: Record<candidateId, number> }
  selection Json

  xrplTxHash      String?
  xrplLedgerIndex Int?
  castAt          DateTime @default(now())

  @@unique([positionId, structureMemberId])
}

