generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  ADMIN
}

model User {
  id                           String                    @id @default(uuid())
  username                     String                    @unique
  phoneNumber                  String?                   @unique
  passwordHash                 String
  role                         UserRole                  @default(MEMBER)
  isSuspended                  Boolean                   @default(false)
  isSelfCustodial              Boolean                   @default(false)
  expoPushToken                String?
  locationLat                  Float?
  locationLng                  Float?
  locationLabel                String?
  locationUpdatedAt            DateTime?
  activeUsernameId             String?                   @unique
  activeUsername               Username?                 @relation("userActiveUsername", fields: [activeUsernameId], references: [id])
  usernamesOwned               Username[]                @relation("usernameOwner")
  usernameBids                 UsernameBid[]             @relation("usernameBids")
  adCampaigns                  AdCampaign[]
  createdAt                    DateTime                  @default(now())
  profile                      UserProfile?
  wallet                       Wallet?
  depositRequests              DepositRequest[]
  toolExecutionLogs            ToolExecutionLog[]
  sentMessages                 Message[]
  chatMemberships              ChatMember[]
  posts                        Post[]
  postLikes                    PostLike[]
  comments                     Comment[]
  communityMemberships         CommunityMember[]
  storyLikes                   StoryLike[]
  storyComments                StoryComment[]
  storyRanks                   StoryRank[]
  storyItemsSold               StoryItem[]               @relation("storyItemsSold")
  storyItemsBought             StoryItem[]               @relation("storyItemsBought")
  whiteGames                   ChessGame[]               @relation("whiteGames")
  blackGames                   ChessGame[]               @relation("blackGames")
  storeApps                    StoreApp[]
  liveRooms                    LiveRoom[]
  ludoGames                    LudoGame[]
  driverProfile                DriverProfile?
  ridesAsRider                 Ride[]                    @relation("ridesAsRider")
  ridesAsDriver                Ride[]                    @relation("ridesAsDriver")
  eatStores                    EatStore[]                @relation("eatStores")
  eatOrders                    EatOrder[]                @relation("eatOrders")
  videos                       Video[]                   @relation("videosUploaded")
  videoLikes                   VideoLike[]
  videoComments                VideoComment[]
  playlists                    Playlist[]
  watchLater                   WatchLater[]
  watchHistory                 WatchHistory[]
  interests                    UserInterest[]
  aiAgent                      AiAgent?
  stories                      Story[]
  propertiesManaged            Property[]                @relation("propertiesManaged")
  tenancies                    Tenancy[]                 @relation("tenancies")
  carListingsSold              CarListing[]              @relation("carListingsSold")
  carEnquiriesMade             CarEnquiry[]              @relation("carEnquiriesMade")
  verification                 Verification?
  wordBattleGames              WordBattleGame[]
  marketplaceListings          MarketplaceListing[]      @relation("marketplaceListings")
  marketplaceBids              MarketplaceBid[]
  invoicesReceived             Invoice[]                 @relation("invoicesReceived")
  invoicesIssued               Invoice[]                 @relation("invoicesIssued")
  giftsSent                    Gift[]                    @relation("giftsSent")
  giftsReceived                Gift[]                    @relation("giftsReceived")
  poolGames                    PoolGame[]
  murabarabaGames              MurabarabaGame[]
  turboRaces                   TurboRacingRace[]
  turboCarUpgrades             TurboCarUpgrades?
  shoppingStores               ShoppingStore[]           @relation("shoppingStores")
  shoppingOrders               ShoppingOrder[]           @relation("shoppingOrders")
  travelStaysHosted            TravelStay[]              @relation("travelStaysHosted")
  travelStayBookings           TravelStayBooking[]       @relation("travelStayBookings")
  travelCarsHosted             TravelCar[]               @relation("travelCarsHosted")
  travelCarBookings            TravelCarBooking[]        @relation("travelCarBookings")
  travelFlightBookings         TravelFlightBooking[]
  travelPackageBookings        TravelPackageBooking[]
  liveQuizAnswers              LiveQuizAnswer[]
  livePollVotes                LivePollVote[]
  livePredictionBets           LivePredictionBet[]
  liveJobApplications          LiveJobApplication[]
  liveQuestionsAsked           LiveQuestion[]
  workCompaniesOwned           WorkCompany[]             @relation("workCompaniesOwned")
  workJobsPosted               WorkJob[]                 @relation("workJobsPosted")
  workJobApplications          WorkJobApplication[]      @relation("workJobApplications")
  workGigsPosted               WorkGig[]                 @relation("workGigsPosted")
  workGigsAssigned             WorkGig[]                 @relation("workGigsAssigned")
  workGigProposals             WorkGigProposal[]         @relation("workGigProposals")
  healthFitnessLogs            HealthFitnessLog[]
  healthPractitionersOwned     HealthPractitioner[]      @relation("healthPractitionersOwned")
  healthAppointmentsBooked     HealthAppointment[]       @relation("healthAppointmentsBooked")
  healthPharmaciesOwned        HealthPharmacy[]          @relation("healthPharmaciesOwned")
  healthPharmacyOrders         HealthPharmacyOrder[]     @relation("healthPharmacyOrders")
  healthWellnessPosts          HealthWellnessPost[]      @relation("healthWellnessPosts")
  healthWellnessLikes          HealthWellnessLike[]      @relation("healthWellnessLikes")
  stokvelsCreated              Stokvel[]                 @relation("stokvelsCreated")
  stokvelMemberships           StokvelMember[]
  stokvelRequestsMade          StokvelFundingRequest[]   @relation("stokvelRequestsMade")
  learningCoursesCreated       LearningCourse[]          @relation("learningCoursesCreated")
  learningEnrollments          LearningEnrollment[]
  learningTutorProfile         LearningTutor?            @relation("learningTutorProfile")
  learningSessionsBooked       LearningTutorSession[]    @relation("learningSessionsBooked")
  learningCommunitiesCreated   LearningCommunity[]       @relation("learningCommunitiesCreated")
  learningCommunityMemberships LearningCommunityMember[]
  learningCommunityPosts       LearningCommunityPost[]
  hairdresserProfile           HairdresserProfile?       @relation("hairdresserProfile")
  hairBookings                 HairBooking[]             @relation("hairBookings")
  entertainmentMovieBookings   MovieBooking[]            @relation("entertainmentMovieBookings")
  entertainmentConcertBookings ConcertBooking[]          @relation("entertainmentConcertBookings")
  entertainmentEventBookings   EventBooking[]            @relation("entertainmentEventBookings")
  eventsOrganized              EventListing[]            @relation("eventOrganizer")
  eventManagerships            EventManager[]            @relation("eventManagerships")
  eventScannerships            EventScanner[]            @relation("eventScannerships")
  adminActionLogs              AdminActionLog[]
  carWashes                    CarWash[]                 @relation("userCarWashes")
  carWashBookings              CarWashBooking[]          @relation("userCarWashBookings")
  referralCode                 String?                   @unique
  cardGamesCreated             CardGame[]                @relation("cardGamesCreated")
  cardRoomsHosted              CardRoom[]
  cardGameStats                CardGameStats[]
  friendRequestsSent           Friendship[]              @relation("friendRequestsSent")
  friendRequestsReceived       Friendship[]              @relation("friendRequestsReceived")
  cardTournamentsCreated       CardTournament[]
  cardTournamentEntries        CardTournamentEntry[]
  achievementsUnlocked         UserAchievement[]
  challengeProgress            UserChallengeProgress[]
  referralsMade                Referral[]                @relation("referralsMade")
  referredBy                   Referral?                 @relation("referredBy")
  reportsFiled                 PlayerReport[]            @relation("reportsFiled")
  reportsReceived              PlayerReport[]            @relation("reportsReceived")
}

model UserProfile {
  id            String  @id @default(uuid())
  userId        String  @unique
  user          User    @relation(fields: [userId], references: [id])
  displayName   String?
  avatarUrl     String?
  bio           String?
  statusMessage String?
}

model Wallet {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id])
  balanceMasheleni Float            @default(0.0)
  xrplAddress      String?
  encryptedSeed    String?
  transactions     Transaction[]
  depositRequests  DepositRequest[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Transaction {
  id        String   @id @default(uuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  txHash    String?
  amount    Decimal
  type      String // SEND, RECEIVE, PAYMENT, DEPOSIT, STORY_LIKE, STORY_COMMENT, STORY_RANK, STORY_ITEM_SALE
  status    String // PENDING, SUCCESS, FAILED
  timestamp DateTime @default(now())
}

// A request to add real-world money (via PayShap or another rail) onto the
// MSH ledger. No live PSP is wired in yet — this tracks the request and its
// manual/admin confirmation; once a real PayShap merchant integration exists,
// its webhook can call the same confirm() path this admin action uses.
model DepositRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  walletId    String
  wallet      Wallet    @relation(fields: [walletId], references: [id])
  reference   String    @unique
  method      String    @default("PAYSHAP")
  amountZar   Float
  status      String    @default("PENDING") // PENDING, PAID, REJECTED
  adminNote   String?
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
}

model Chat {
  id          String       @id @default(uuid())
  type        String // DIRECT, GROUP, CHANNEL
  name        String?
  communityId String?
  community   Community?   @relation(fields: [communityId], references: [id])
  createdAt   DateTime     @default(now())
  members     ChatMember[]
  messages    Message[]
}

model ChatMember {
  id         String   @id @default(uuid())
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  role       String   @default("MEMBER") // ADMIN, MOD, MEMBER
  joinedAt   DateTime @default(now())
  lastReadAt DateTime @default(now())

  @@unique([chatId, userId])
}

model Message {
  id            String    @id @default(uuid())
  chatId        String
  chat          Chat      @relation(fields: [chatId], references: [id])
  senderId      String
  sender        User      @relation(fields: [senderId], references: [id])
  content       String
  mediaUrl      String?
  isAiGenerated Boolean   @default(false)
  isForwarded   Boolean   @default(false)
  replyToId     String?
  replyTo       Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies       Message[] @relation("MessageReplies")
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  @@index([replyToId])
}

model Post {
  id        String     @id @default(uuid())
  authorId  String
  author    User       @relation(fields: [authorId], references: [id])
  content   String
  mediaUrl  String?
  mediaType String?
  likes     PostLike[]
  comments  Comment[]
  createdAt DateTime   @default(now())
}

model PostLike {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model Community {
  id          String            @id @default(uuid())
  name        String
  description String?
  iconUrl     String?
  createdAt   DateTime          @default(now())
  members     CommunityMember[]
  rooms       Chat[]
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  role        String    @default("MEMBER") // ADMIN, MOD, MEMBER
  joinedAt    DateTime  @default(now())

  @@unique([communityId, userId])
}

// Paid, once-per-user-per-story interactions on labeled ("of the Day") stories.
// Each charges CCR_RATE MSH straight to the story's author — see story.service.ts.
model StoryLike {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}

model StoryComment {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}

model StoryRank {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  value     Int // 1-10
  createdAt DateTime @default(now())

  @@unique([storyId, userId])
}

model StoryItem {
  id        String    @id @default(uuid())
  storyId   String
  story     Story     @relation(fields: [storyId], references: [id])
  name      String
  brand     String?
  price     Decimal?
  isForSale Boolean   @default(false)
  sellerId  String?
  seller    User?     @relation("storyItemsSold", fields: [sellerId], references: [id])
  buyerId   String?
  buyer     User?     @relation("storyItemsBought", fields: [buyerId], references: [id])
  soldAt    DateTime?
  createdAt DateTime  @default(now())
}

model ChessGame {
  id          String   @id @default(uuid())
  whiteId     String
  blackId     String
  whitePlayer User     @relation("whiteGames", fields: [whiteId], references: [id])
  blackPlayer User     @relation("blackGames", fields: [blackId], references: [id])
  pgn         String   @db.Text
  fen         String   @db.Text
  status      String // "active", "draw", "white_won", "black_won"
  timeControl Int // seconds, 0 for infinite
  whiteTime   Int // remaining seconds
  blackTime   Int // remaining seconds
  lastMoveAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LiveRoom {
  id         String    @id @default(uuid())
  roomName   String    @unique // LiveKit room name
  title      String
  categoryId String
  hostId     String
  host       User      @relation(fields: [hostId], references: [id])
  isLive     Boolean   @default(true)
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  // Category-specific live state. Denormalized onto the room since
  // each field is a single "current" value per stream, not a
  // collection — Live Shopping/Food pin one product at a time,
  // Gaming Live links one game at a time, Sports Live tracks one
  // scoreboard. Collections (quizzes, polls, predictions, jobs,
  // questions) get their own tables below.
  pinnedShoppingProductId String?
  pinnedEatProductId      String?
  linkedGameType          String? // 'pool' | 'ludo' | 'chess' | 'murabaraba' | 'wordbattle'
  linkedGameId            String?
  scoreTeamA              String?
  scoreTeamB              String?
  scoreA                  Int     @default(0)
  scoreB                  Int     @default(0)

  quizzes     LiveQuiz[]
  polls       LivePoll[]
  predictions LivePrediction[]
  jobPostings LiveJobPosting[]
  questions   LiveQuestion[]
}

// ── Education Live: real quizzes with an optional host-funded prize ──────
model LiveQuiz {
  id           String           @id @default(uuid())
  roomId       String
  room         LiveRoom         @relation(fields: [roomId], references: [id])
  question     String
  options      String[]
  correctIndex Int
  prizePool    Float            @default(0)
  status       String           @default("OPEN") // OPEN | RESOLVED
  createdAt    DateTime         @default(now())
  answers      LiveQuizAnswer[]
}

model LiveQuizAnswer {
  id          String   @id @default(uuid())
  quizId      String
  quiz        LiveQuiz @relation(fields: [quizId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  optionIndex Int
  correct     Boolean
  answeredAt  DateTime @default(now())

  @@unique([quizId, userId])
}

// ── Entertainment Live: real-time polls ──────────────────────────────────
model LivePoll {
  id        String         @id @default(uuid())
  roomId    String
  room      LiveRoom       @relation(fields: [roomId], references: [id])
  question  String
  options   String[]
  status    String         @default("OPEN") // OPEN | CLOSED
  createdAt DateTime       @default(now())
  votes     LivePollVote[]
}

model LivePollVote {
  id          String   @id @default(uuid())
  pollId      String
  poll        LivePoll @relation(fields: [pollId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  optionIndex Int
  votedAt     DateTime @default(now())

  @@unique([pollId, userId])
}

// ── Sports Live: pari-mutuel prediction pool funded by bettors ───────────
model LivePrediction {
  id        String              @id @default(uuid())
  roomId    String
  room      LiveRoom            @relation(fields: [roomId], references: [id])
  question  String
  optionA   String
  optionB   String
  status    String              @default("OPEN") // OPEN | RESOLVED_A | RESOLVED_B
  createdAt DateTime            @default(now())
  bets      LivePredictionBet[]
}

model LivePredictionBet {
  id           String         @id @default(uuid())
  predictionId String
  prediction   LivePrediction @relation(fields: [predictionId], references: [id])
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  pick         String // 'A' | 'B'
  amount       Float
  payout       Float?
  createdAt    DateTime       @default(now())

  @@unique([predictionId, userId])
}

// ── Career Live: real job postings + applications ────────────────────────
model LiveJobPosting {
  id           String               @id @default(uuid())
  roomId       String
  room         LiveRoom             @relation(fields: [roomId], references: [id])
  title        String
  description  String?
  salary       String?
  createdAt    DateTime             @default(now())
  applications LiveJobApplication[]
}

model LiveJobApplication {
  id          String         @id @default(uuid())
  jobId       String
  job         LiveJobPosting @relation(fields: [jobId], references: [id])
  applicantId String
  applicant   User           @relation(fields: [applicantId], references: [id])
  message     String?
  createdAt   DateTime       @default(now())
}

// ── Social Live: live Q&A queue ───────────────────────────────────────────
model LiveQuestion {
  id        String   @id @default(uuid())
  roomId    String
  room      LiveRoom @relation(fields: [roomId], references: [id])
  askerId   String
  asker     User     @relation(fields: [askerId], references: [id])
  text      String
  answered  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LudoGame {
  id               String   @id @default(uuid())
  mode             String // '1v1' | '2v2' | '2v2v2' | '4v4' | '1v5'
  seats            Json // [{ seatIndex, userId, isAI, displayName }]
  tokens           Json // number[][] — local step count per seat per token
  currentSeat      Int      @default(0)
  diceValue        Int?
  consecutiveSixes Int      @default(0)
  status           String   @default("active") // 'active' | 'finished'
  winnerTeam       Int?
  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 8-Ball Pool: physics runs client-side (deterministic, no randomness), so
// the server doesn't simulate shots itself — it just persists whatever
// authoritative result the on-turn player's client reports (turn ownership
// is checked before accepting it) and relays raw shot inputs so the other
// client can replay the identical animation locally.
model PoolGame {
  id          String   @id @default(uuid())
  seats       Json // [{ seatIndex, userId, isAI, displayName }]
  balls       Json // Ball[]
  state       Json // { turn, groups, openTable, winner, winReason, message, shotsTaken }
  wager       Float    @default(0)
  status      String   @default("active") // 'active' | 'finished'
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Murabaraba online play: rules run authoritatively on the server
// (packages/types/src/morabarabaRules.ts). Team modes (2v2, 1v3) don't
// change the 2-sided board itself — `seats` maps each human seat to a
// side (0|1) and `turnCursor` round-robins whichever teammate acts next.
model MurabarabaGame {
  id          String   @id @default(uuid())
  mode        String // '1v1' | '2v2' | '1v3'
  seats       Json // [{ seatIndex, side, userId, isAI, displayName }]
  state       Json // GameState (board, turn, cowsToPlace, captured, ...)
  activeSeat  Int      @default(0)
  turnCursor  Json // [number, number] — next local seat index per side
  status      String   @default("active") // 'active' | 'finished'
  winnerSide  Int?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Turbo Racing: an endless-lane-runner sprint to a fixed finish
// distance. Physics runs entirely client-side (deterministic given the
// shared `seed`, same trust model as PoolGame) — the server just relays
// each racer's self-reported progress to the other racer and persists
// final standings + rewards.
model TurboRacingRace {
  id             String   @id @default(uuid())
  seed           Int
  finishDistance Int      @default(3000)
  seats          Json // [{ seatIndex, userId, displayName, distance, lane, crashed, coins, rank, finishedAt }]
  status         String   @default("active") // 'active' | 'finished'
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TurboCarUpgrades {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  speedLevel    Int      @default(0)
  accelLevel    Int      @default(0)
  handlingLevel Int      @default(0)
  color         String   @default("#DC2626")
  updatedAt     DateTime @updatedAt
}

model StoreApp {
  id          String   @id @default(uuid())
  name        String
  description String?
  type        String // "Game" or "Plugin"
  iconUrl     String? // Could be an ionic icon name or a real URL
  color       String? // Color for the card
  sourceUrl   String? // The URL of the external web app
  developerId String? // Optional for built-in apps
  developer   User?    @relation(fields: [developerId], references: [id])
  isNative    Boolean  @default(false)
  nativeRoute String? // e.g. "Category", "Arcade"
  routeParams String? // JSON string for params
  createdAt   DateTime @default(now())
}

model EatStore {
  id          String       @id @default(uuid())
  ownerId     String
  owner       User         @relation("eatStores", fields: [ownerId], references: [id])
  name        String
  description String?
  logoUrl     String?
  coverUrl    String?
  address     String
  category    String
  isOpen      Boolean      @default(true)
  rating      Float        @default(0)
  products    EatProduct[]
  orders      EatOrder[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model EatProduct {
  id          String         @id @default(uuid())
  storeId     String
  store       EatStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  imageUrl    String?
  category    String?
  isAvailable Boolean        @default(true)
  orderItems  EatOrderItem[]
  createdAt   DateTime       @default(now())
}

model EatOrder {
  id              String         @id @default(uuid())
  customerId      String
  customer        User           @relation("eatOrders", fields: [customerId], references: [id])
  storeId         String
  store           EatStore       @relation(fields: [storeId], references: [id])
  items           EatOrderItem[]
  status          String         @default("PENDING")
  subtotal        Float
  serviceFee      Float
  deliveryFee     Float
  total           Float
  deliveryAddress String
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model EatOrderItem {
  id        String     @id @default(uuid())
  orderId   String
  order     EatOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   EatProduct @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

// ============================================================
// Shopping — "Brand stores" general retail, same one-store-per-user
// model as Eat, minus delivery logistics. The differentiator is
// cashback: every paid order credits a percentage of the subtotal
// straight back to the buyer's wallet as a 'REWARD' transaction.
// ============================================================

model ShoppingStore {
  id          String            @id @default(uuid())
  ownerId     String
  owner       User              @relation("shoppingStores", fields: [ownerId], references: [id])
  name        String
  description String?
  logoUrl     String?
  coverUrl    String?
  category    String
  isOpen      Boolean           @default(true)
  rating      Float             @default(0)
  products    ShoppingProduct[]
  orders      ShoppingOrder[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ShoppingProduct {
  id          String              @id @default(uuid())
  storeId     String
  store       ShoppingStore       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  imageUrl    String?
  category    String?
  isAvailable Boolean             @default(true)
  orderItems  ShoppingOrderItem[]
  createdAt   DateTime            @default(now())
}

model ShoppingOrder {
  id              String              @id @default(uuid())
  customerId      String
  customer        User                @relation("shoppingOrders", fields: [customerId], references: [id])
  storeId         String
  store           ShoppingStore       @relation(fields: [storeId], references: [id])
  items           ShoppingOrderItem[]
  status          String              @default("PLACED") // PLACED | CONFIRMED | SHIPPED | DELIVERED | CANCELLED
  subtotal        Float
  total           Float
  rewardEarned    Float               @default(0)
  shippingAddress String
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model ShoppingOrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     ShoppingOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   ShoppingProduct @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model DriverProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  isOnline     Boolean  @default(false)
  currentLat   Float?
  currentLng   Float?
  vehicleMake  String?
  vehicleModel String?
  vehiclePlate String?
  rating       Float    @default(5.0)
  totalRides   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Ride {
  id             String   @id @default(uuid())
  riderId        String
  rider          User     @relation("ridesAsRider", fields: [riderId], references: [id])
  driverId       String?
  driver         User?    @relation("ridesAsDriver", fields: [driverId], references: [id])
  pickupLat      Float
  pickupLng      Float
  pickupAddress  String?
  dropoffLat     Float
  dropoffLng     Float
  dropoffAddress String?
  status         String // REQUESTED, ACCEPTED, IN_PROGRESS, COMPLETED, CANCELLED
  fare           Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── Discover / Video ──────────────────────────────────────────────────────────

model Video {
  id           String          @id @default(uuid())
  title        String
  description  String?         @db.Text
  url          String
  thumbnailUrl String?
  duration     Int // seconds
  views        Int             @default(0)
  category     String
  tags         String[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  creatorId    String
  creator      User            @relation("videosUploaded", fields: [creatorId], references: [id])
  likes        VideoLike[]
  comments     VideoComment[]
  playlists    PlaylistVideo[]
  watchHistory WatchHistory[]
  watchLater   WatchLater[]
}

model VideoLike {
  id        String   @id @default(uuid())
  videoId   String
  userId    String
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([videoId, userId])
}

model VideoComment {
  id        String   @id @default(uuid())
  text      String
  videoId   String
  userId    String
  createdAt DateTime @default(now())
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model Playlist {
  id        String          @id @default(uuid())
  name      String
  isPublic  Boolean         @default(true)
  userId    String
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id])
  videos    PlaylistVideo[]
}

model PlaylistVideo {
  id         String   @id @default(uuid())
  playlistId String
  videoId    String
  position   Int      @default(0)
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
}

model WatchLater {
  id      String   @id @default(uuid())
  userId  String
  videoId String
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id])
  video   Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model WatchHistory {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  progress  Int      @default(0)
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model UserInterest {
  id       String @id @default(uuid())
  userId   String
  category String
  user     User   @relation(fields: [userId], references: [id])

  @@unique([userId, category])
}

model AiAgent {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  name        String   @default("Aura")
  gender      String   @default("neutral")
  voice       String   @default("warm")
  personality String   @default("companion")
  permissions Json     @default("{}")
  onboarded   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiReminder {
  id        String    @id @default(uuid())
  userId    String
  title     String
  fireAt    DateTime
  prepNote  String?
  done      Boolean   @default(false)
  firedAt   DateTime?
  createdAt DateTime  @default(now())
}

// Audit trail for every AI tool invocation (Tool Registry / Action Executor).
// Bare userId (no relation), matching AiReminder — operational/audit table.
model ToolExecutionLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  toolName   String
  input      Json
  output     Json?
  status     String   @default("PENDING") // PENDING | SUCCESS | FAILED
  error      String?
  durationMs Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([toolName])
}

// One row per user: what the AI agent is currently focused on, persisted
// across chat turns (the Context Manager's backing store).
model AiSession {
  id           String   @id @default(uuid())
  userId       String   @unique
  activeModule String?
  taskSummary  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Durable log of every real user/assistant exchange (not intermediate tool
// chatter) — backs "access to old conversations": the mobile chat screen
// loads this on open instead of starting blank, and a recent slice is folded
// into the system prompt so the AI has continuity across separate sessions,
// not just within one still-open conversation. Bare userId, no relation,
// matching AiReminder/ToolExecutionLog — an operational/audit-style table.
model AiConversationMessage {
  id          String   @id @default(uuid())
  userId      String
  // null = the user's own personal AiAgent (Aura/Zed/etc, existing behavior).
  // Set to a FIXED_COMPANIONS id ('sipho' | 'thandi' | 'guranda-assistant')
  // for the platform-provided friend/FAQ personas, so each persona's history
  // stays isolated from the personal companion's and from each other's.
  companionId String?
  role        String // user | assistant
  content     String
  createdAt   DateTime @default(now())

  @@index([userId, companionId, createdAt])
}

// CarFind — a car classifieds mini app (modeled on carfind.co.za): sellers
// list a car with specs and photos, buyers browse/filter and send an
// enquiry. No in-app payment for the vehicle itself — like the real site,
// buyer and seller connect and complete the sale outside the app.
model CarListing {
  id           String       @id @default(uuid())
  sellerId     String
  seller       User         @relation("carListingsSold", fields: [sellerId], references: [id])
  title        String
  make         String
  model        String
  year         Int
  price        Float // asking price in MSH
  mileage      Int // km
  transmission String // MANUAL, AUTOMATIC
  fuelType     String // PETROL, DIESEL, HYBRID, ELECTRIC
  bodyType     String // SEDAN, HATCHBACK, SUV, BAKKIE, COUPE, VAN
  condition    String       @default("USED") // NEW, USED
  location     String
  description  String?
  images       String[]     @default([])
  sold         Boolean      @default(false)
  createdAt    DateTime     @default(now())
  enquiries    CarEnquiry[]

  @@index([make, model])
  @@index([price])
}

model CarEnquiry {
  id        String     @id @default(uuid())
  listingId String
  listing   CarListing @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User       @relation("carEnquiriesMade", fields: [buyerId], references: [id])
  message   String
  createdAt DateTime   @default(now())
}

// Server-side install state for mini apps and modules, keyed by the same
// string ids the mobile client already uses locally (module ids like
// 'travel', 'work', game ids, or a StoreApp row's id). Bare userId (no
// relation), matching AiReminder/ToolExecutionLog — lets the AI runtime see
// and change install state, not just the mobile client's local AsyncStorage.
model InstalledApp {
  id          String   @id @default(uuid())
  userId      String
  appId       String
  installedAt DateTime @default(now())

  @@unique([userId, appId])
  @@index([userId])
}

model Story {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  mediaUrl        String?
  textContent     String?
  backgroundColor String?
  musicUrl        String?
  musicTitle      String?
  stickers        Json?
  // Freeform, uppercase-normalized "of the Day" tag (e.g. "OOTD", "COTD").
  // null = general story. Non-null makes it eligible for the labeled/trending
  // feed and its paid interactions below.
  label           String?
  expiresAt       DateTime
  createdAt       DateTime       @default(now())
  likes           StoryLike[]
  comments        StoryComment[]
  ranks           StoryRank[]
  items           StoryItem[]

  @@index([label, expiresAt])
}

// ── Property module ────────────────────────────────────────────
// Any user can be an estate agent: list properties, assign tenants,
// track rent, issue receipts and leases. Tenants pay rent from the
// Guranda wallet and report issues.

model Property {
  id          String    @id @default(uuid())
  agentId     String
  agent       User      @relation("propertiesManaged", fields: [agentId], references: [id])
  title       String
  kind        String // HOUSE, APARTMENT, COMMERCIAL
  listingType String // RENT, SALE
  price       Float // monthly rent or sale price in MSH
  address     String
  description String?
  images      String[]  @default([])
  bedrooms    Int       @default(0)
  bathrooms   Int       @default(0)
  available   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  tenancies   Tenancy[]
}

model Tenancy {
  id         String          @id @default(uuid())
  propertyId String
  property   Property        @relation(fields: [propertyId], references: [id])
  tenantId   String
  tenant     User            @relation("tenancies", fields: [tenantId], references: [id])
  rentAmount Float
  startDate  DateTime        @default(now())
  active     Boolean         @default(true)
  payments   RentPayment[]
  issues     PropertyIssue[]
}

model RentPayment {
  id        String   @id @default(uuid())
  tenancyId String
  tenancy   Tenancy  @relation(fields: [tenancyId], references: [id])
  amount    Float
  period    String // e.g. "2026-07"
  receiptNo String
  paidAt    DateTime @default(now())
}

model PropertyIssue {
  id          String   @id @default(uuid())
  tenancyId   String
  tenancy     Tenancy  @relation(fields: [tenancyId], references: [id])
  title       String
  description String?
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  createdAt   DateTime @default(now())
}

// ============================================================
// Account verification (KYC-style) — gates wallet use and
// creator funds. Personal info is collected at registration;
// ID/business/certificates are submitted later to unlock
// verified status.
// ============================================================

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model Verification {
  id     String             @id @default(uuid())
  userId String             @unique
  user   User               @relation(fields: [userId], references: [id])
  status VerificationStatus @default(UNVERIFIED)

  // Mandatory personal info, collected at registration
  firstName   String
  lastName    String
  occupation  String
  dateOfBirth DateTime?

  // ID document, submitted later to request verification
  idType        String? // NATIONAL_ID, PASSPORT, DRIVERS_LICENSE
  idNumber      String?
  idDocumentUrl String?

  hasBusiness Boolean @default(false)
  isGraduate  Boolean @default(false)

  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?

  businesses   Business[]
  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Business {
  id                 String       @id @default(uuid())
  verificationId     String
  verification       Verification @relation(fields: [verificationId], references: [id])
  name               String
  registrationNumber String?
  documents          String[]     @default([])
  createdAt          DateTime     @default(now())
}

model Certificate {
  id             String       @id @default(uuid())
  verificationId String
  verification   Verification @relation(fields: [verificationId], references: [id])
  title          String
  issuer         String?
  fileUrl        String
  createdAt      DateTime     @default(now())
}

enum FeatureAccess {
  ALL
  VERIFIED_ONLY
  OFF
}

model FeatureFlag {
  id        String        @id @default(uuid())
  key       String        @unique
  access    FeatureAccess @default(ALL)
  updatedAt DateTime      @updatedAt
}

// ============================================================
// Word Battle — three modes (Wordle Duel, Boggle, Scrabble)
// sharing one authoritative game row. State is a mode-specific
// JSON blob; secrets (Wordle's word, Scrabble racks/bag) never
// leave the server except through per-seat sanitized payloads.
// ============================================================

enum WordBattleMode {
  WORDLE
  BOGGLE
  SCRABBLE
}

model WordBattleGame {
  id          String         @id @default(uuid())
  mode        WordBattleMode
  seats       Json // [{ seatIndex, userId, isAI, displayName }]
  state       Json // mode-specific authoritative state
  status      String         @default("active") // 'active' | 'finished'
  winnerSeat  Int?
  wager       Float          @default(0)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// ============================================================
// Marketplace — buy, sell and auction anything, paid straight
// from the Guranda wallet. Fixed-price listings settle instantly;
// auctions accumulate bids and settle when they expire.
// ============================================================

enum ListingType {
  FIXED
  AUCTION
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  CANCELLED
}

model MarketplaceListing {
  id              String           @id @default(uuid())
  sellerId        String
  seller          User             @relation("marketplaceListings", fields: [sellerId], references: [id])
  title           String
  description     String?
  category        String
  condition       String // NEW, LIKE_NEW, GOOD, FAIR
  images          String[]         @default([])
  listingType     ListingType
  price           Float // fixed price, or auction starting price
  status          ListingStatus    @default(ACTIVE)
  auctionEndsAt   DateTime?
  currentBid      Float?
  currentBidderId String?
  buyerId         String?
  soldAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bids            MarketplaceBid[]
  invoices        Invoice[]
}

model MarketplaceBid {
  id        String             @id @default(uuid())
  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id])
  bidderId  String
  bidder    User               @relation(fields: [bidderId], references: [id])
  amount    Float
  createdAt DateTime           @default(now())
}

model Invoice {
  id            String             @id @default(uuid())
  invoiceNumber String             @unique
  listingId     String
  listing       MarketplaceListing @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User               @relation("invoicesReceived", fields: [buyerId], references: [id])
  sellerId      String
  seller        User               @relation("invoicesIssued", fields: [sellerId], references: [id])
  itemTitle     String
  amount        Float
  createdAt     DateTime           @default(now())
}

enum UsernameSaleStatus {
  NONE
  FIXED
  AUCTION
}

enum UsernameAcquiredVia {
  FREE_CLAIM
  MINT
  MARKETPLACE_BUY
  AUCTION_WIN
  ADMIN_SEED
}

// A username is a permanent, ownable, tradeable asset — distinct from
// User.username (which mirrors whichever Username row is currently active,
// so every existing screen reading user.username keeps working untouched).
// Reputation lives here (not on User) precisely so it can freeze and
// transfer with a sale: see UsernameService.activate() for the baseline+
// delta mechanic that keeps this in sync with real account activity while
// active, and snapshots it the instant the user switches away.
model Username {
  id    String @id @default(uuid())
  label String @unique // normalized lowercase [a-z0-9_]{3,}

  ownerId   String
  owner     User   @relation("usernameOwner", fields: [ownerId], references: [id])
  activeFor User?  @relation("userActiveUsername")

  isActive Boolean @default(false)

  reputationScore                   Float  @default(0)
  subscribersScore                  Float  @default(0)
  level                             String @default("Nano")
  activationLiveReputationBaseline  Float  @default(0)
  activationLiveSubscribersBaseline Float  @default(0)

  acquiredVia UsernameAcquiredVia
  acquiredAt  DateTime            @default(now())

  saleStatus      UsernameSaleStatus @default(NONE)
  price           Float?
  auctionEndsAt   DateTime?
  currentBid      Float?
  currentBidderId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bids UsernameBid[]

  @@index([ownerId])
  @@index([saleStatus])
}

model UsernameBid {
  id         String   @id @default(uuid())
  usernameId String
  username   Username @relation(fields: [usernameId], references: [id])
  bidderId   String
  bidder     User     @relation("usernameBids", fields: [bidderId], references: [id])
  amount     Float
  createdAt  DateTime @default(now())
}

// Lightweight sale-history record — not reused from Invoice, which is
// FK-tight to MarketplaceListing specifically.
model UsernameSale {
  id         String   @id @default(uuid())
  usernameId String
  sellerId   String
  buyerId    String
  price      Float
  createdAt  DateTime @default(now())
}

model ReservedUsername {
  id        String   @id @default(uuid())
  label     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

enum AdCampaignStatus {
  ACTIVE
  PAUSED
  ENDED
}

// Deliberately minimal — no budget pacing/bidding/billing. Reach is decided
// by the same ContentRankingService used for organic content, keyed off the
// advertiser's own activeUsername reputation + location.
model AdCampaign {
  id             String           @id @default(uuid())
  advertiserId   String
  advertiser     User             @relation(fields: [advertiserId], references: [id])
  title          String
  creativeUrl    String
  targetAudience String?
  status         AdCampaignStatus @default(ACTIVE)
  impressions    Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([advertiserId])
  @@index([status])
}

// A gift is a wallet transfer wrapped with catalog metadata (which preset
// item, an optional message) and tagged with where it happened — a Live
// stream (viewer supporting a streamer) or a game (player to player).
model Gift {
  id          String   @id @default(uuid())
  senderId    String
  sender      User     @relation("giftsSent", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("giftsReceived", fields: [recipientId], references: [id])
  giftType    String // catalog key: rose | heart | confetti | trophy | diamond | rocket
  amount      Float
  context     String // 'live' | 'game'
  contextId   String? // roomName or gameId
  message     String?
  createdAt   DateTime @default(now())
}

// ── Travel ─────────────────────────────────────────────────────────────
// Stays and Car Hire follow the same any-user-can-host model as
// Eat/Property/Shopping. Flights and Holiday Packages are a curated,
// seeded catalog — no individual user realistically runs an airline or
// tour operator, so those two are booking-only against fixed inventory.

model TravelStay {
  id            String              @id @default(uuid())
  hostId        String
  host          User                @relation("travelStaysHosted", fields: [hostId], references: [id])
  title         String
  description   String?
  location      String
  pricePerNight Float
  maxGuests     Int                 @default(2)
  amenities     String[]            @default([])
  imageUrl      String?
  isActive      Boolean             @default(true)
  rating        Float               @default(0)
  bookings      TravelStayBooking[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model TravelStayBooking {
  id         String     @id @default(uuid())
  stayId     String
  stay       TravelStay @relation(fields: [stayId], references: [id])
  guestId    String
  guest      User       @relation("travelStayBookings", fields: [guestId], references: [id])
  checkIn    DateTime
  checkOut   DateTime
  guests     Int        @default(1)
  nights     Int
  totalPrice Float
  status     String     @default("CONFIRMED") // CONFIRMED | CANCELLED
  createdAt  DateTime   @default(now())
}

model TravelCar {
  id          String             @id @default(uuid())
  hostId      String
  host        User               @relation("travelCarsHosted", fields: [hostId], references: [id])
  make        String
  model       String
  category    String // Economy | SUV | Luxury | Van | Convertible
  location    String
  pricePerDay Float
  imageUrl    String?
  isActive    Boolean            @default(true)
  rating      Float              @default(0)
  bookings    TravelCarBooking[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model TravelCarBooking {
  id         String    @id @default(uuid())
  carId      String
  car        TravelCar @relation(fields: [carId], references: [id])
  guestId    String
  guest      User      @relation("travelCarBookings", fields: [guestId], references: [id])
  pickupDate DateTime
  returnDate DateTime
  days       Int
  totalPrice Float
  status     String    @default("CONFIRMED")
  createdAt  DateTime  @default(now())
}

model TravelFlight {
  id             String                @id @default(uuid())
  airline        String
  flightNumber   String
  origin         String
  destination    String
  departureTime  DateTime
  arrivalTime    DateTime
  price          Float
  seatsTotal     Int                   @default(150)
  seatsAvailable Int                   @default(150)
  bookings       TravelFlightBooking[]
  createdAt      DateTime              @default(now())
}

model TravelFlightBooking {
  id         String       @id @default(uuid())
  flightId   String
  flight     TravelFlight @relation(fields: [flightId], references: [id])
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  passengers Int          @default(1)
  totalPrice Float
  status     String       @default("CONFIRMED")
  createdAt  DateTime     @default(now())
}

model TravelPackage {
  id           String                 @id @default(uuid())
  title        String
  description  String?
  destination  String
  imageUrl     String?
  durationDays Int
  price        Float
  includes     String[]               @default([])
  bookings     TravelPackageBooking[]
  createdAt    DateTime               @default(now())
}

model TravelPackageBooking {
  id         String        @id @default(uuid())
  packageId  String
  package    TravelPackage @relation(fields: [packageId], references: [id])
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  travelers  Int           @default(1)
  totalPrice Float
  status     String        @default("CONFIRMED")
  createdAt  DateTime      @default(now())
}

// ── Work ───────────────────────────────────────────────────────────────
// Jobs, Freelancing, Businesses and Hiring — any user can register a
// company and post openings (mirrors Shopping/Eat's any-user-can-host
// model, not gated behind verification since a job posting itself moves
// no money). Freelance gigs are the one part of Work that touches the
// wallet: the client's budget is debited when they accept a proposal
// (held, same "debit now / credit on resolve" pattern as Live's
// pari-mutuel sports predictions) and paid out to the freelancer when
// the client approves the submitted work.

model WorkCompany {
  id          String    @id @default(uuid())
  ownerId     String
  owner       User      @relation("workCompaniesOwned", fields: [ownerId], references: [id])
  name        String
  description String?
  logoUrl     String?
  website     String?
  industry    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  jobs        WorkJob[]
}

model WorkJob {
  id             String               @id @default(uuid())
  companyId      String
  company        WorkCompany          @relation(fields: [companyId], references: [id])
  postedById     String
  postedBy       User                 @relation("workJobsPosted", fields: [postedById], references: [id])
  title          String
  description    String
  category       String?
  employmentType String // 'Full-time' | 'Part-time' | 'Contract' | 'Internship'
