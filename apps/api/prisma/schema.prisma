  totalAmount Float

  scheduledFor DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Cards platform — 5 Cards + Cassino (South African house rules).
// seats/state JSON blobs mirror WordBattleGame/LudoGame's shape;
// state is always the full authoritative blob, never sent to a
// client unsanitized (see cards.service.ts sanitizeGameForSeat).
// ============================================================

enum CardGameMode {
  FIVE_CARDS
  CASSINO
}

enum CassinoMode {
  ONE_V_ONE
  TWO_V_TWO
  FFA
}

model CardGame {
  id                String         @id @default(uuid())
  mode              CardGameMode
  cassinoMode       CassinoMode?
  roomId            String?
  room              CardRoom?      @relation(fields: [roomId], references: [id])
  tournamentMatchId String?        @unique
  seats             Json
  state             Json
  status            String         @default("active")
  winnerSeat        Int?
  winnerTeam        Int?
  ranked            Boolean        @default(false)
  wager             Float          @default(0)
  createdById       String
  createdBy         User           @relation("cardGamesCreated", fields: [createdById], references: [id])
  moves             CardGameMove[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

// NET-NEW room/lobby concept — no equivalent exists for the other games in
// this codebase. Every room gets a roomCode regardless of privacy so it
// always has a shareable deep-link; public rooms are additionally listable.
model CardRoom {
  id        String       @id @default(uuid())
  mode      CardGameMode
  hostId    String
  host      User         @relation(fields: [hostId], references: [id])
  isPrivate Boolean      @default(false)
  roomCode  String       @unique @default(cuid())
  maxSeats  Int          @default(4)
  settings  Json
  status    String       @default("waiting")
  games     CardGame[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// Per-user, per-mode aggregate stats/rating — powers ranked matchmaking,
// leaderboards, and achievement criteria from one row.
model CardGameStats {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  mode         CardGameMode
  rating       Int          @default(1200)
  wins         Int          @default(0)
  losses       Int          @default(0)
  fastestWinMs Int?
  gamesPlayed  Int          @default(0)
  sweeps       Int          @default(0)
  updatedAt    DateTime     @updatedAt

  @@unique([userId, mode])
}

// Full move ledger — powers match history AND replay. Each move stores the
// resulting full authoritative state snapshot, so replay is "step through
// stored snapshots," never "re-simulate and hope the engine version matches."
model CardGameMove {
  id            String   @id @default(uuid())
  gameId        String
  game          CardGame @relation(fields: [gameId], references: [id])
  seatIndex     Int
  action        String
  payload       Json
  stateSnapshot Json
  createdAt     DateTime @default(now())
}

// Cross-game friend graph — NET-NEW, no Friend/Friendship model existed
// anywhere in this schema before. Used for real friend-invites into a room,
// on top of the shareable room-code deep-link.
model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  requester   User     @relation("friendRequestsSent", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User     @relation("friendRequestsReceived", fields: [addresseeId], references: [id])
  status      String   @default("pending") // pending | accepted | declined | blocked
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
}

// Single-elimination bracket tournaments.
model CardTournament {
  id          String                @id @default(uuid())
  mode        CardGameMode
  name        String
  entryFee    Float                 @default(0)
  prizePool   Float                 @default(0)
  maxPlayers  Int
  status      String                @default("registration") // registration | active | completed | cancelled
  startAt     DateTime?
  createdById String
  createdBy   User                  @relation(fields: [createdById], references: [id])
  entries     CardTournamentEntry[]
  rounds      CardTournamentRound[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model CardTournamentEntry {
  id           String         @id @default(uuid())
  tournamentId String
  tournament   CardTournament @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  seedIndex    Int?
  eliminated   Boolean        @default(false)
  placement    Int?
  joinedAt     DateTime       @default(now())

  @@unique([tournamentId, userId])
}

model CardTournamentRound {
  id           String         @id @default(uuid())
  tournamentId String
  tournament   CardTournament @relation(fields: [tournamentId], references: [id])
  roundNumber  Int
  matchups     Json // [{ entryAId, entryBId|null (bye), gameId?, winnerEntryId? }]
  status       String         @default("pending") // pending | active | complete
  createdAt    DateTime       @default(now())
}

model Achievement {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  description String
  icon        String?
  criteria    Json // { type: 'wins'|'sweeps'|'fastestWinMs'|'gamesPlayed', threshold: number, mode?: CardGameMode }
  createdAt   DateTime          @default(now())
  unlocks     UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

// ── Profile Digital Headquarters ──────────────────────────────────────────
// Daily cron-written snapshot so the profile pillar cards can say "up 12%
// this week" instead of a bare number — diff the live value against the
// row closest to 7 days ago rather than maintaining four separate history
// tables.
model ProfileMetricsSnapshot {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  reputation          Float
  subscribers         Float
  xp                  Int
  challengesCompleted Int
  giftsReceived       Int
  capturedAt          DateTime @default(now())

  @@index([userId, capturedAt])
}

// A visual companion that evolves with UserProfile.xp — reuses the existing
// Challenges XP currency rather than inventing a new one, so it only grows
// with meaningful activity (completing challenges), not idle screen time.
model Companion {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  name          String   @default("Companion")
  stage         Int      @default(0) // derived from xp, capped at 5
  lastEvolvedAt DateTime @default(now())
}

// Scarce, ownable collectibles — distinct from the generic, uncapped
// Achievement/UserAchievement unlocks above. Some badges are capped by
// maxSupply (first-N style scarcity); others are uncapped and auto-minted
// when a specific Achievement unlocks (see achievements.service.ts).
model Badge {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  description String
  icon        String
  maxSupply   Int?
  mintedCount Int         @default(0)
  createdAt   DateTime    @default(now())
  owners      UserBadge[]
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  mintedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model DailyChallenge {
  id              String                  @id @default(uuid())
  mode            CardGameMode?
  description     String
  criteria        Json // { type: 'playGames'|'winGames'|'sweep'|'winWithoutBuilds', target: number }
  rewardMasheleni Float                   @default(0)
  activeDate      DateTime                @db.Date
  progress        UserChallengeProgress[]
  createdAt       DateTime                @default(now())

  @@unique([mode, activeDate, description])
}

model UserChallengeProgress {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  challengeId String
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id])
  progress    Int            @default(0)
  completed   Boolean        @default(false)
  claimedAt   DateTime?

  @@unique([userId, challengeId])
}

model Referral {
  id           String   @id @default(uuid())
  referrerId   String
  referrer     User     @relation("referralsMade", fields: [referrerId], references: [id])
  refereeId    String   @unique
  referee      User     @relation("referredBy", fields: [refereeId], references: [id])
  rewardStatus String   @default("pending") // pending | paid
  rewardAmount Float    @default(0)
  createdAt    DateTime @default(now())
}

model PlayerReport {
  id             String   @id @default(uuid())
  reporterId     String
  reporter       User     @relation("reportsFiled", fields: [reporterId], references: [id])
  reportedUserId String
  reportedUser   User     @relation("reportsReceived", fields: [reportedUserId], references: [id])
  gameId         String?
  reason         String // 'cheating' | 'abusive_chat' | 'afk' | 'other'
  details        String?
  status         String   @default("open") // open | reviewed | actioned | dismissed
  reviewedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================
// Challenges — public UGC challenge platform (Explore tab). Distinct from
// DailyChallenge/UserChallengeProgress above, which are Cards-game-only.
// Admin-curated (see AdminAccessGuard-gated challenges-admin controller);
// status transitions DRAFT -> ACTIVE -> ENDED on an hourly cron sweep by
// startAt/endAt, the same idempotent-by-window approach DailyChallenge's
// midnight cron uses, just finer-grained to support Flash Challenges (1-3h).
// ============================================================

enum ChallengeCategory {
  DANCE
  COMEDY
  FITNESS
  GAMING
  PHOTOGRAPHY
  COOKING
  BUSINESS
  MUSIC
  LIFESTYLE
  SPORTS
  COUPLES
  SPONSORED
}

enum ChallengeType {
  DAILY
  FLASH
  WEEKEND
  SEASONAL
  SPONSORED
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  ENDED
}

model Challenge {
  id               String                @id @default(uuid())
  title            String
  description      String
  promptText       String?
  category         ChallengeCategory
  type             ChallengeType
  status           ChallengeStatus       @default(DRAFT)
  scope            String                @default("NATIONAL") // LOCAL | DISTRICT | PROVINCIAL | NATIONAL
  location         String? // human-readable label, e.g. "Soweto", "Gauteng"
  startAt          DateTime
  endAt            DateTime
  xpReward         Int                   @default(50)
  bonusXpReward    Int                   @default(100)
  coverImageUrl    String?
  // Simple display label for Phase 1 ("Sponsored by X") — not a full
  // sponsor campaign/budget system, see roadmap.
  sponsorLabel     String?
  createdByAdminId String?
  // Set when the challenge transitions to ENDED — the entry with the
  // highest average vote (like count as tiebreaker) at close, whose author
  // is awarded bonusXpReward. No relation (plain id pointer, like
  // createdByAdminId) since it's set after the entries already exist.
  winningEntryId   String?
  createdAt        DateTime              @default(now())
  entries          ChallengeEntry[]
  sponsorship      ChallengeSponsorship?

  @@index([status, category])
  @@index([status, endAt])
  @@index([scope])
}

model ChallengeEntry {
  id          String                  @id @default(uuid())
  challengeId String
  challenge   Challenge               @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User                    @relation(fields: [userId], references: [id])
  mediaUrl    String
  mediaType   String // IMAGE | VIDEO
  caption     String?
  status      String                  @default("PUBLISHED") // PUBLISHED | REMOVED
  createdAt   DateTime                @default(now())
  likes       ChallengeEntryLike[]
  votes       ChallengeEntryVote[]
  comments    ChallengeEntryComment[]

  @@unique([challengeId, userId])
}

model ChallengeEntryLike {
  id        String         @id @default(uuid())
  entryId   String
  entry     ChallengeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([entryId, userId])
}

model ChallengeEntryVote {
  id        String         @id @default(uuid())
  entryId   String
  entry     ChallengeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  value     Int // 1-10
  createdAt DateTime       @default(now())

  @@unique([entryId, userId])
}

model ChallengeEntryComment {
  id          String         @id @default(uuid())
  entryId     String
  entry       ChallengeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  authorId    String
  author      User           @relation(fields: [authorId], references: [id])
  content     String
  boostAmount Float          @default(0) // MSH paid to pin this comment; 0 = free
  boostedAt   DateTime? // set when a boost payment is made
  createdAt   DateTime       @default(now())

  @@index([entryId, boostAmount])
}

model ChallengeCategoryStat {
  id           String            @id @default(uuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  category     ChallengeCategory
  xp           Int               @default(0)
  entriesCount Int               @default(0)
  wins         Int               @default(0)

  @@unique([userId, category])
}

model UserChallengeStreak {
  userId            String    @id
  user              User      @relation(fields: [userId], references: [id])
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastCompletedDate DateTime? @db.Date
}

// ============================================================
// Relationships — profile status + partner linking (mirrors Friendship's
// request/accept/decline shape exactly). Couples Challenges (below) build on
// top of the accepted Relationship row.
// ============================================================

enum RelationshipStatusType {
  SINGLE
  IN_RELATIONSHIP
  MARRIED
  PREFER_NOT_TO_SAY
}

model RelationshipRequest {
  id             String                 @id @default(uuid())
  requesterId    String
  requester      User                   @relation("relationshipRequestsSent", fields: [requesterId], references: [id])
  partnerId      String
  partner        User                   @relation("relationshipRequestsReceived", fields: [partnerId], references: [id])
  // IN_RELATIONSHIP or MARRIED — carried from the sender's picker choice so
  // acceptRequest() can set both profiles' UserProfile.relationshipStatus
  // to the same value once accepted.
  intendedStatus RelationshipStatusType @default(IN_RELATIONSHIP)
  status         String                 @default("pending") // pending | accepted | declined
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([requesterId, partnerId])
}

model Relationship {
  id               String    @id @default(uuid())
  userAId          String
  userA            User      @relation("relationshipUserA", fields: [userAId], references: [id])
  userBId          String
  userB            User      @relation("relationshipUserB", fields: [userBId], references: [id])
  anniversaryDate  DateTime?
  startDate        DateTime  @default(now())
  xp               Int       @default(0)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime? @db.Date
  status           String    @default("active") // active | ended
  createdAt        DateTime  @default(now())

  // The couple's shared spice-level preference for Truth or Dare / Spin the
  // Bottle / Couples Cards. SPICY only actually unlocks once BOTH partners
  // have opted in here AND both have a verified 18+ dateOfBirth (checked at
  // request time in CouplesService — never trust this field alone).
  spiceLevel  SpiceLevel @default(SWEET)
  spicyOptInA Boolean    @default(false)
  spicyOptInB Boolean    @default(false)

  completions CoupleChallengeCompletion[]
  promptsSeen CouplePromptSeen[]

  @@unique([userAId, userBId])
}

// ============================================================
// Couples Challenges — a fixed, ordered, two-person progression (unlock
// level N by completing level N-1; completed levels stay viewable).
// Deliberately NOT built on the generic Challenge/ChallengeEntry tables —
// those are a rotating pool anyone can enter, this is a per-couple sequence.
// ============================================================

model CoupleChallengeTemplate {
  id           String   @id @default(uuid())
  level        Int      @unique
  title        String
  description  String
  instructions String?
  xpReward     Int      @default(50)
  createdAt    DateTime @default(now())

  completions CoupleChallengeCompletion[]
}

model CoupleChallengeCompletion {
  id                String                  @id @default(uuid())
  relationshipId    String
  relationship      Relationship            @relation(fields: [relationshipId], references: [id])
  templateId        String
  template          CoupleChallengeTemplate @relation(fields: [templateId], references: [id])
  completedAt       DateTime                @default(now())
  completedByUserId String
  note              String?

  @@unique([relationshipId, templateId])
}

// ============================================================
// Truth or Dare / Spin the Bottle / Couples Cards — one shared prompt pool
// (by type + spice level) drawn from for all three game shells. SPICY
// content is intimate/suggestive by design, never graphic — see the
// content notes in couples.service.ts's SEED_PROMPTS. Gated behind mutual
// opt-in (Relationship.spicyOptInA/B) plus a verified 18+ dateOfBirth for
// both partners, checked server-side on every draw.
// ============================================================

enum CouplePromptType {
  TRUTH
  DARE
  CARD
}

enum SpiceLevel {
  SWEET
  FLIRTY
  SPICY
}

model CouplePrompt {
  id         String             @id @default(uuid())
  type       CouplePromptType
  spiceLevel SpiceLevel
  text       String
  createdAt  DateTime           @default(now())
  seenBy     CouplePromptSeen[]

  @@index([type, spiceLevel])
}

// A prompt this couple has already drawn — lets a draw pick from the
// unseen remainder of the pool first, reshuffling (clearing these rows for
// that type+level) once they've exhausted it, like a shuffled deck.
model CouplePromptSeen {
  id             String       @id @default(uuid())
  relationshipId String
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  promptId       String
  prompt         CouplePrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  seenAt         DateTime     @default(now())

  @@unique([relationshipId, promptId])
}

// ============================================================
// Sponsor integration — a verified Business proposes+pays for a Challenge.
// No escrow/reserve mechanism (none exists anywhere in this codebase) — the
// budget is debited atomically, once, at admin-approval time, same pattern
// as every other money flow here (see ChallengesService/story chargeInteraction).
// ============================================================

model ChallengeSponsorship {
  id          String    @id @default(uuid())
  challengeId String    @unique
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  // Denormalized display name at time of sponsorship — becomes
  // Challenge.sponsorLabel on approval, so the existing Phase-1 "Sponsored
  // by X" mobile UI (ChallengeCard.tsx/ChallengeDetailScreen.tsx) picks it
  // up with zero new rendering code.
  sponsorName String
  budget      Float
  status      String    @default("PENDING") // PENDING | ACTIVE | REJECTED
  createdAt   DateTime  @default(now())
}

// ============================================================
// Opportunities Carousel — business campaigns, mini-app launches, platform
// updates, creator promos and reviewer recommendations. Deliberately
// separate from Challenge/ChallengeSponsorship above: Challenges are
// community missions (fun, XP reward, no money); Campaigns are business
// contracts (real budget, real reward). Same card-rendering framework on
// mobile, distinct data model and tone so the two never read as the same
// thing. Money-on-approval flow mirrors ChallengeSponsorship exactly (see
// campaigns.service.ts) — no escrow, full budget debited atomically only
// when an admin approves.
// ============================================================

enum CampaignType {
  BUSINESS
  MINI_APP_LAUNCH
  PLATFORM_UPDATE
  CREATOR_PROMO
  REVIEWER_RECOMMENDATION
}

enum CampaignStatus {
  PENDING
  ACTIVE
  REJECTED
  ENDED
}

model Campaign {
  id                       String         @id @default(uuid())
  type                     CampaignType
  status                   CampaignStatus @default(PENDING)
  title                    String
  description              String
  // Free string, not an enum — mirrors Challenge.scope's documented-not-enum
  // convention. e.g. "Awareness" | "Installs" | "Visits" | "Reviews".
  goal                     String
  rewardLabel              String
  estimatedMinutes         Int?
  actionLabel              String
  // {name, params} — the same shape LifeModule.route already uses app-wide,
  // so the mobile action button is just navigation.navigate(name, params).
  actionRoute              Json
  coverImageUrl            String?
  budget                   Float          @default(0)
  // Audience targeting only — never gates who can CREATE a campaign. Null
  // means visible to everyone. One of reputation.util.ts's LEVEL_THRESHOLDS
  // level names (Nano/Micro/Midtier/Macro/Mega Influencer).
  targetMinReputationLevel String?
  targetCategories         String[]       @default([])
  // Nullable: PLATFORM_UPDATE campaigns are createable via the admin
  // shared-key path (AdminAccessGuard), which has no adminId to attribute —
  // see AdminAccessGuard's actorLabel: 'shared-key' comment.
  createdByUserId          String?
  createdByUser            User?          @relation(fields: [createdByUserId], references: [id])
  // Only set for BUSINESS / MINI_APP_LAUNCH types — the verified Business
  // whose wallet is debited on approval.
  createdByBusinessId      String?
  createdByBusiness        Business?      @relation(fields: [createdByBusinessId], references: [id])
  startAt                  DateTime
  endAt                    DateTime
  impressions              Int            @default(0)
  clicks                   Int            @default(0)
  completions              Int            @default(0)
  createdAt                DateTime       @default(now())

  metricsSnapshots CampaignMetricsSnapshot[]

  @@index([status, type])
  @@index([status, endAt])
}

// Daily snapshot for campaign analytics — identical shape/cadence to
// BusinessMetricsSnapshot below, so CampaignAnalyticsScreen can diff "now"
// against "~7 days ago" the same way BusinessInsightsService does.
model CampaignMetricsSnapshot {
  id          String   @id @default(uuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  impressions Int
  clicks      Int
  completions Int
  spent       Float
  capturedAt  DateTime @default(now())

  @@index([campaignId, capturedAt])
}

enum AnnouncementContext {
  MINI_APP
  CAMPAIGN
}

// Contextual news — never a menu item. contextKey is either a MINI_APP_IDS
// id (e.g. "travel") or a Campaign id. Rendered inline by
// ContextualNewsBanner wherever that context is on screen.
model Announcement {
  id                  String              @id @default(uuid())
  contextType         AnnouncementContext
  contextKey          String
  title               String
  body                String
  iconUrl             String?
  // Plain id pointer, not a relation — mirrors Challenge.createdByAdminId's
  // convention (admin actions are audited separately via AdminAuditService).
  createdByAdminId    String?
  // Real relation (unlike createdByAdminId above) — the service enforces a
  // business can only post to a contextKey equal to one of its own campaigns.
  createdByBusinessId String?
  createdByBusiness   Business?           @relation(fields: [createdByBusinessId], references: [id])
  createdAt           DateTime            @default(now())
  expiresAt           DateTime?

  @@index([contextType, contextKey, createdAt])
}

// ============================================================
// Business/Creator Dashboard — AI-narrated insights + account-mode badge
// (product vision §23-25). AccountType is deliberately NOT the same concept
// as the `Business` model above (that's a verified/KYB legal entity used for
// challenge sponsorship); this is a lightweight, mostly-derived UI framing
// for the Dashboard command centre that any account can carry.
// ============================================================

enum AccountType {
  PERSONAL
  CREATOR
  MERCHANT
  BUSINESS
}

// Daily cron-written snapshot of the Dashboard's real, already-computed
// business numbers (total mini-app revenue, per-app revenue, social/video/
// story engagement) so BusinessInsightsService can diff "now" against "~7
// days ago" and hand the AI a REAL week-over-week percentage instead of
// letting it invent one. Mirrors ProfileMetricsSnapshot's cron shape one-row-
// per-user-per-day, diffed against the row closest to 7 days back — kept as
// its own table rather than reusing ProfileMetricsSnapshot because these are
// a different set of numbers (business/dashboard, not profile pillars) with
// a different owner (BusinessInsightsService, not ProfileService).
model BusinessMetricsSnapshot {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  totalRevenue       Float
  // [{ id: string, label: string, revenue: number }] — one entry per owned
  // mini app with defined revenue at capture time, so a per-app delta can be
  // computed later without a separate table per mini-app.
  perAppRevenue      Json
  postCount          Int
  videoViews         Int
  // likesReceived + commentsReceived + ranksReceived on the user's Stories,
  // composed into one number the same way ProfileService composes "Impact".
  storyEngagement    Int
  giftsReceivedTotal Float
  capturedAt         DateTime @default(now())

  @@index([userId, capturedAt])
}
