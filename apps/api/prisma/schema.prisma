  thumbnailUrl String?
  status       String   @default("PUBLISHED") // DRAFT | PUBLISHED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lessons     LearningLesson[]
  enrollments LearningEnrollment[]
}

model LearningLesson {
