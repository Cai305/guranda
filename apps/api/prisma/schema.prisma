generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase's pooled connection (PgBouncer transaction mode, port 6543) doesn't
  // support the prepared statements `prisma db push`/`migrate` need — schema
  // changes must go through the direct connection instead. Runtime queries keep
  // using the pooled `url` above; only schema operations use this.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  MEMBER
  ADMIN
}

model User {
  id                           String                     @id @default(uuid())
  username                     String                     @unique
  phoneNumber                  String?                    @unique
  passwordHash                 String
  role                         UserRole                   @default(MEMBER)
  isSuspended                  Boolean                    @default(false)
  failedLoginAttempts          Int                        @default(0)
  lockedUntil                  DateTime?
  isSelfCustodial              Boolean                    @default(false)
  expoPushToken                String?
  locationLat                  Float?
  locationLng                  Float?
  locationLabel                String?
  locationUpdatedAt            DateTime?
  activeUsernameId             String?                    @unique
  activeUsername               Username?                  @relation("userActiveUsername", fields: [activeUsernameId], references: [id])
  usernamesOwned               Username[]                 @relation("usernameOwner")
  usernameBids                 UsernameBid[]              @relation("usernameBids")
  adCampaigns                  AdCampaign[]
  createdAt                    DateTime                   @default(now())
  profile                      UserProfile?
  wallet                       Wallet?
  depositRequests              DepositRequest[]
  paymentRequestsMade          PaymentRequest[]           @relation("paymentRequestsMade")
  paymentRequestsReceived      PaymentRequest[]           @relation("paymentRequestsReceived")
  toolExecutionLogs            ToolExecutionLog[]
  sentMessages                 Message[]
  chatMemberships              ChatMember[]
  posts                        Post[]
  postLikes                    PostLike[]
  postReposts                  PostRepost[]
  postBookmarks                PostBookmark[]
  // Follow rows where I'm the follower — people I follow.
  follows                      Follow[]                   @relation("UserFollows")
  // Follow rows where I'm being followed — my followers.
  followedBy                   Follow[]                   @relation("UserFollowedBy")
  comments                     Comment[]
  commentLikes                 CommentLike[]
  communityMemberships         CommunityMember[]
  storyLikes                   StoryLike[]
  storyComments                StoryComment[]
  storyRanks                   StoryRank[]
  storyItemsSold               StoryItem[]                @relation("storyItemsSold")
  storyItemsBought             StoryItem[]                @relation("storyItemsBought")
  whiteGames                   ChessGame[]                @relation("whiteGames")
  blackGames                   ChessGame[]                @relation("blackGames")
  storeApps                    StoreApp[]
  liveRooms                    LiveRoom[]
  ludoGames                    LudoGame[]
  driverProfile                DriverProfile?
  ridesAsRider                 Ride[]                     @relation("ridesAsRider")
  ridesAsDriver                Ride[]                     @relation("ridesAsDriver")
  eatStores                    EatStore[]                 @relation("eatStores")
  eatOrders                    EatOrder[]                 @relation("eatOrders")
  videos                       Video[]                    @relation("videosUploaded")
  videoLikes                   VideoLike[]
  videoComments                VideoComment[]
  creatorSubscriptionsMade     CreatorSubscription[]      @relation("subscriptionsMade")
  creatorSubscriptionsReceived CreatorSubscription[]      @relation("subscriptionsReceived")
  playlists                    Playlist[]
  watchLater                   WatchLater[]
  watchHistory                 WatchHistory[]
  interests                    UserInterest[]
  aiAgent                      AiAgent?
  stories                      Story[]
  storyViews                   StoryView[]
  propertiesManaged            Property[]                 @relation("propertiesManaged")
  tenancies                    Tenancy[]                  @relation("tenancies")
  carListingsSold              CarListing[]               @relation("carListingsSold")
  carEnquiriesMade             CarEnquiry[]               @relation("carEnquiriesMade")
  verification                 Verification?
  wordBattleGames              WordBattleGame[]
  marketplaceListings          MarketplaceListing[]       @relation("marketplaceListings")
  marketplaceBids              MarketplaceBid[]
  invoicesReceived             Invoice[]                  @relation("invoicesReceived")
  invoicesIssued               Invoice[]                  @relation("invoicesIssued")
  giftsSent                    Gift[]                     @relation("giftsSent")
  giftsReceived                Gift[]                     @relation("giftsReceived")
  poolGames                    PoolGame[]
  murabarabaGames              MurabarabaGame[]
  turboRaces                   TurboRacingRace[]
  turboCarUpgrades             TurboCarUpgrades?
  shoppingStores               ShoppingStore[]            @relation("shoppingStores")
  shoppingOrders               ShoppingOrder[]            @relation("shoppingOrders")
  travelStaysHosted            TravelStay[]               @relation("travelStaysHosted")
  travelStayBookings           TravelStayBooking[]        @relation("travelStayBookings")
  travelCarsHosted             TravelCar[]                @relation("travelCarsHosted")
  travelCarBookings            TravelCarBooking[]         @relation("travelCarBookings")
  travelFlightBookings         TravelFlightBooking[]
  travelPackageBookings        TravelPackageBooking[]
  liveQuizAnswers              LiveQuizAnswer[]
  livePollVotes                LivePollVote[]
  livePredictionBets           LivePredictionBet[]
  liveJobApplications          LiveJobApplication[]
  liveDatingApplications       LiveDatingApplicant[]
  liveModeratorRoles           LiveRoomModerator[]
  liveModerationActions        LiveRoomModerationAction[]
  liveRoomGuestInvites         LiveRoomGuest[]
  liveQuestionsAsked           LiveQuestion[]
  workCompaniesOwned           WorkCompany[]              @relation("workCompaniesOwned")
  workJobsPosted               WorkJob[]                  @relation("workJobsPosted")
  workJobApplications          WorkJobApplication[]       @relation("workJobApplications")
  workGigsPosted               WorkGig[]                  @relation("workGigsPosted")
  workGigsAssigned             WorkGig[]                  @relation("workGigsAssigned")
  workGigProposals             WorkGigProposal[]          @relation("workGigProposals")
  healthFitnessLogs            HealthFitnessLog[]
  healthPractitionersOwned     HealthPractitioner[]       @relation("healthPractitionersOwned")
  healthAppointmentsBooked     HealthAppointment[]        @relation("healthAppointmentsBooked")
  healthPharmaciesOwned        HealthPharmacy[]           @relation("healthPharmaciesOwned")
  healthPharmacyOrders         HealthPharmacyOrder[]      @relation("healthPharmacyOrders")
  healthWellnessPosts          HealthWellnessPost[]       @relation("healthWellnessPosts")
  healthWellnessLikes          HealthWellnessLike[]       @relation("healthWellnessLikes")
  stokvelsCreated              Stokvel[]                  @relation("stokvelsCreated")
  stokvelMemberships           StokvelMember[]
  stokvelRequestsMade          StokvelFundingRequest[]    @relation("stokvelRequestsMade")
  structuresCreated            Structure[]                @relation("structuresCreated")
  structureMemberships         StructureMember[]
  learningCoursesCreated       LearningCourse[]           @relation("learningCoursesCreated")
  learningEnrollments          LearningEnrollment[]
  learningTutorProfile         LearningTutor?             @relation("learningTutorProfile")
  learningSessionsBooked       LearningTutorSession[]     @relation("learningSessionsBooked")
  learningCommunitiesCreated   LearningCommunity[]        @relation("learningCommunitiesCreated")
  learningCommunityMemberships LearningCommunityMember[]
  learningCommunityPosts       LearningCommunityPost[]
  hairdresserProfile           HairdresserProfile?        @relation("hairdresserProfile")
  hairBookings                 HairBooking[]              @relation("hairBookings")
  entertainmentMovieBookings   MovieBooking[]             @relation("entertainmentMovieBookings")
  entertainmentConcertBookings ConcertBooking[]           @relation("entertainmentConcertBookings")
  entertainmentEventBookings   EventBooking[]             @relation("entertainmentEventBookings")
  eventsOrganized              EventListing[]             @relation("eventOrganizer")
  eventManagerships            EventManager[]             @relation("eventManagerships")
  eventScannerships            EventScanner[]             @relation("eventScannerships")
  adminActionLogs              AdminActionLog[]
  carWashes                    CarWash[]                  @relation("userCarWashes")
  carWashBookings              CarWashBooking[]           @relation("userCarWashBookings")
  referralCode                 String?                    @unique
  cardGamesCreated             CardGame[]                 @relation("cardGamesCreated")
  cardRoomsHosted              CardRoom[]
  cardGameStats                CardGameStats[]
  friendRequestsSent           Friendship[]               @relation("friendRequestsSent")
  friendRequestsReceived       Friendship[]               @relation("friendRequestsReceived")
  cardTournamentsCreated       CardTournament[]
  cardTournamentEntries        CardTournamentEntry[]
  achievementsUnlocked         UserAchievement[]
  profileMetricsSnapshots      ProfileMetricsSnapshot[]
  companion                    Companion?
  badges                       UserBadge[]
  businessMetricsSnapshots     BusinessMetricsSnapshot[]
  challengeProgress            UserChallengeProgress[]
  referralsMade                Referral[]                 @relation("referralsMade")
  referredBy                   Referral?                  @relation("referredBy")
  reportsFiled                 PlayerReport[]             @relation("reportsFiled")
  reportsReceived              PlayerReport[]             @relation("reportsReceived")
  liveStreamReportsFiled       LiveStreamReport[]         @relation("LiveStreamReportsFiled")
  liveStreamReportsReceived    LiveStreamReport[]         @relation("LiveStreamReportsReceived")
  liveStreamReportsReviewed    LiveStreamReport[]         @relation("LiveStreamReportsReviewed")
  challengeEntries             ChallengeEntry[]
  challengeEntryLikes          ChallengeEntryLike[]
  challengeEntryVotes          ChallengeEntryVote[]
  challengeEntryComments       ChallengeEntryComment[]
  challengeCategoryStats       ChallengeCategoryStat[]
  challengeStreak              UserChallengeStreak?
  relationshipRequestsSent     RelationshipRequest[]      @relation("relationshipRequestsSent")
  relationshipRequestsReceived RelationshipRequest[]      @relation("relationshipRequestsReceived")
  relationshipsAsUserA         Relationship[]             @relation("relationshipUserA")
  relationshipsAsUserB         Relationship[]             @relation("relationshipUserB")
