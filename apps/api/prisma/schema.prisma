// ── Entertainment ────────────────────────────────────────────────────────
// Movies, Music (concerts) and Live Events — a curated, platform-owned
// catalog (seeded, no user hosting) mirroring Travel's Flight/Package
// verticals rather than Stay/Car's any-user-can-host model. Streaming is
// intentionally NOT a new catalog here — it reuses the existing Live
// module's 'entertainment' category (see liveCategories.ts) instead of
// duplicating it.

model Movie {
  id           String          @id @default(uuid())
  title        String
  posterUrl    String?
  genre        String
  rating       String // age rating, e.g. PG13
  synopsis     String?
  durationMins Int
  showtimes    MovieShowtime[]
  createdAt    DateTime        @default(now())
}

model MovieShowtime {
  id             String         @id @default(uuid())
  movieId        String
  movie          Movie          @relation(fields: [movieId], references: [id])
  cinema         String
  startsAt       DateTime
  price          Float
  seatsTotal     Int            @default(80)
  seatsAvailable Int            @default(80)
  bookings       MovieBooking[]
}

model MovieBooking {
  id         String        @id @default(uuid())
  showtimeId String
  showtime   MovieShowtime @relation(fields: [showtimeId], references: [id])
  userId     String
  user       User          @relation("entertainmentMovieBookings", fields: [userId], references: [id])
  seats      Int           @default(1)
  totalPrice Float
  status     String        @default("CONFIRMED")
  createdAt  DateTime      @default(now())
}

model Concert {
  id               String           @id @default(uuid())
  artist           String
  title            String
  genre            String
  venue            String
  city             String
  startsAt         DateTime
  posterUrl        String?
  price            Float
  ticketsTotal     Int              @default(500)
  ticketsAvailable Int              @default(500)
  bookings         ConcertBooking[]
  createdAt        DateTime         @default(now())
}

model ConcertBooking {
  id         String   @id @default(uuid())
  concertId  String
  concert    Concert  @relation(fields: [concertId], references: [id])
  userId     String
  user       User     @relation("entertainmentConcertBookings", fields: [userId], references: [id])
  tickets    Int      @default(1)
  totalPrice Float
  status     String   @default("CONFIRMED")
  createdAt  DateTime @default(now())
}

// Live Events are open, any-user-hosted (like Eat/Shopping) — organizerId is
// nullable so the platform-curated/seeded events keep working with no owner.
// An organizer can bring on co-managers (full edit rights, added by username
// or by sharing a manager invite code) and scanners (ticket check-in only,
// added the same two ways via a separate scanner invite code).
model EventListing {
  id                String         @id @default(uuid())
  organizerId       String?
  organizer         User?          @relation("eventOrganizer", fields: [organizerId], references: [id])
  title             String
  category          String // Comedy | Theatre | Sports | Festival
  venue             String
  city              String
  startsAt          DateTime
  posterUrl         String?
  description       String?
  price             Float
  ticketsTotal      Int            @default(300)
  ticketsAvailable  Int            @default(300)
  managerInviteCode String?        @unique
  scannerInviteCode String?        @unique
  bookings          EventBooking[]
  managers          EventManager[]
  scanners          EventScanner[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
}

model EventManager {
  id        String       @id @default(uuid())
  eventId   String
  event     EventListing @relation(fields: [eventId], references: [id])
  userId    String
  user      User         @relation("eventManagerships", fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([eventId, userId])
}

model EventScanner {
  id        String       @id @default(uuid())
  eventId   String
  event     EventListing @relation(fields: [eventId], references: [id])
  userId    String
  user      User         @relation("eventScannerships", fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([eventId, userId])
}

model EventBooking {
  id          String        @id @default(uuid())
  eventId     String
  event       EventListing  @relation(fields: [eventId], references: [id])
  userId      String
  user        User          @relation("entertainmentEventBookings", fields: [userId], references: [id])
  tickets     Int           @default(1)
  totalPrice  Float
  status      String        @default("CONFIRMED")
  ticketItems EventTicket[]
  createdAt   DateTime      @default(now())
}

// One row per individual, independently scannable ticket — a booking of 3
// tickets creates 3 of these so friends can walk in separately.
model EventTicket {
  id          String       @id @default(uuid())
  bookingId   String
  booking     EventBooking @relation(fields: [bookingId], references: [id])
  code        String       @unique
  checkedIn   Boolean      @default(false)
  checkedInAt DateTime?
  checkedInBy String?
  createdAt   DateTime     @default(now())
}

// ============================================================
// Admin audit trail. adminId is nullable: the admin surface currently
// supports two auth modes (see admin/admin-access.guard.ts) — a per-user
// JWT from a User with role=ADMIN (adminId recorded), or the legacy shared
// ADMIN_API_KEY used by the website's ops dashboard today, which carries no
// individual identity (adminId left null, actorLabel records "shared-key").
// ============================================================
model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      User?    @relation(fields: [adminId], references: [id])
  actorLabel String // e.g. the admin's username, or "shared-key"
  action     String // e.g. "user.suspend", "feature-flag.set"
  targetType String? // e.g. "User", "FeatureFlag"
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

// -----------------------------------------------------------------------------
// Car Wash Mini App
// -----------------------------------------------------------------------------

model CarWash {
  id          String  @id @default(uuid())
  ownerId     String
  owner       User    @relation("userCarWashes", fields: [ownerId], references: [id])
  name        String
  description String?
  address     String
  isOpen      Boolean @default(true)
  rating      Float   @default(0)

  services CarWashService[]
  bookings CarWashBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CarWashService {
  id          String  @id @default(uuid())
  carWashId   String
  carWash     CarWash @relation(fields: [carWashId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float
  isAvailable Boolean @default(true)

  bookings CarWashBooking[]

  createdAt DateTime @default(now())
}

enum CarWashBookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model CarWashBooking {
  id        String         @id @default(uuid())
  carWashId String
  carWash   CarWash        @relation(fields: [carWashId], references: [id], onDelete: Cascade)
  serviceId String
  service   CarWashService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation("userCarWashBookings", fields: [userId], references: [id])

  status      CarWashBookingStatus @default(PENDING)
  totalAmount Float

  scheduledFor DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Cards platform — 5 Cards + Cassino (South African house rules).
// seats/state JSON blobs mirror WordBattleGame/LudoGame's shape;
// state is always the full authoritative blob, never sent to a
// client unsanitized (see cards.service.ts sanitizeGameForSeat).
// ============================================================

enum CardGameMode {
  FIVE_CARDS
  CASSINO
}

enum CassinoMode {
  ONE_V_ONE
  TWO_V_TWO
  FFA
}

model CardGame {
  id                String         @id @default(uuid())
  mode              CardGameMode
  cassinoMode       CassinoMode?
  roomId            String?
  room              CardRoom?      @relation(fields: [roomId], references: [id])
  tournamentMatchId String?        @unique
  seats             Json
  state             Json
  status            String         @default("active")
  winnerSeat        Int?
  winnerTeam        Int?
  ranked            Boolean        @default(false)
  wager             Float          @default(0)
  createdById       String
  createdBy         User           @relation("cardGamesCreated", fields: [createdById], references: [id])
  moves             CardGameMove[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

// NET-NEW room/lobby concept — no equivalent exists for the other games in
// this codebase. Every room gets a roomCode regardless of privacy so it
// always has a shareable deep-link; public rooms are additionally listable.
model CardRoom {
  id        String       @id @default(uuid())
  mode      CardGameMode
  hostId    String
  host      User         @relation(fields: [hostId], references: [id])
  isPrivate Boolean      @default(false)
  roomCode  String       @unique @default(cuid())
  maxSeats  Int          @default(4)
  settings  Json
  status    String       @default("waiting")
  games     CardGame[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// Per-user, per-mode aggregate stats/rating — powers ranked matchmaking,
// leaderboards, and achievement criteria from one row.
model CardGameStats {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  mode         CardGameMode
  rating       Int          @default(1200)
  wins         Int          @default(0)
  losses       Int          @default(0)
  fastestWinMs Int?
  gamesPlayed  Int          @default(0)
  sweeps       Int          @default(0)
  updatedAt    DateTime     @updatedAt

  @@unique([userId, mode])
}

// Full move ledger — powers match history AND replay. Each move stores the
// resulting full authoritative state snapshot, so replay is "step through
// stored snapshots," never "re-simulate and hope the engine version matches."
model CardGameMove {
  id            String   @id @default(uuid())
  gameId        String
  game          CardGame @relation(fields: [gameId], references: [id])
  seatIndex     Int
  action        String
  payload       Json
  stateSnapshot Json
  createdAt     DateTime @default(now())
}

// Cross-game friend graph — NET-NEW, no Friend/Friendship model existed
// anywhere in this schema before. Used for real friend-invites into a room,
// on top of the shareable room-code deep-link.
model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  requester   User     @relation("friendRequestsSent", fields: [requesterId], references: [id])
  addresseeId String
  addressee   User     @relation("friendRequestsReceived", fields: [addresseeId], references: [id])
  status      String   @default("pending") // pending | accepted | declined | blocked
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
}

// Single-elimination bracket tournaments.
model CardTournament {
  id          String                @id @default(uuid())
  mode        CardGameMode
  name        String
  entryFee    Float                 @default(0)
  prizePool   Float                 @default(0)
  maxPlayers  Int
  status      String                @default("registration") // registration | active | completed | cancelled
  startAt     DateTime?
  createdById String
  createdBy   User                  @relation(fields: [createdById], references: [id])
  entries     CardTournamentEntry[]
  rounds      CardTournamentRound[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model CardTournamentEntry {
  id           String         @id @default(uuid())
  tournamentId String
  tournament   CardTournament @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  seedIndex    Int?
  eliminated   Boolean        @default(false)
  placement    Int?
  joinedAt     DateTime       @default(now())

  @@unique([tournamentId, userId])
}

model CardTournamentRound {
  id           String         @id @default(uuid())
  tournamentId String
  tournament   CardTournament @relation(fields: [tournamentId], references: [id])
  roundNumber  Int
  matchups     Json // [{ entryAId, entryBId|null (bye), gameId?, winnerEntryId? }]
  status       String         @default("pending") // pending | active | complete
  createdAt    DateTime       @default(now())
}

model Achievement {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  description String
  icon        String?
  criteria    Json // { type: 'wins'|'sweeps'|'fastestWinMs'|'gamesPlayed', threshold: number, mode?: CardGameMode }
  createdAt   DateTime          @default(now())
  unlocks     UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model DailyChallenge {
  id              String                  @id @default(uuid())
  mode            CardGameMode?
  description     String
  criteria        Json // { type: 'playGames'|'winGames'|'sweep'|'winWithoutBuilds', target: number }
  rewardMasheleni Float                   @default(0)
  activeDate      DateTime                @db.Date
  progress        UserChallengeProgress[]
  createdAt       DateTime                @default(now())

  @@unique([mode, activeDate, description])
}

model UserChallengeProgress {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  challengeId String
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id])
  progress    Int            @default(0)
  completed   Boolean        @default(false)
  claimedAt   DateTime?

  @@unique([userId, challengeId])
}

model Referral {
  id           String   @id @default(uuid())
  referrerId   String
  referrer     User     @relation("referralsMade", fields: [referrerId], references: [id])
  refereeId    String   @unique
  referee      User     @relation("referredBy", fields: [refereeId], references: [id])
  rewardStatus String   @default("pending") // pending | paid
  rewardAmount Float    @default(0)
  createdAt    DateTime @default(now())
}

model PlayerReport {
  id             String   @id @default(uuid())
  reporterId     String
  reporter       User     @relation("reportsFiled", fields: [reporterId], references: [id])
  reportedUserId String
  reportedUser   User     @relation("reportsReceived", fields: [reportedUserId], references: [id])
  gameId         String?
  reason         String // 'cheating' | 'abusive_chat' | 'afk' | 'other'
  details        String?
  status         String   @default("open") // open | reviewed | actioned | dismissed
  reviewedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
