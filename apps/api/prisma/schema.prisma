// ── Entertainment ────────────────────────────────────────────────────────
// Movies, Music (concerts) and Live Events — a curated, platform-owned
// catalog (seeded, no user hosting) mirroring Travel's Flight/Package
// verticals rather than Stay/Car's any-user-can-host model. Streaming is
// intentionally NOT a new catalog here — it reuses the existing Live
// module's 'entertainment' category (see liveCategories.ts) instead of
// duplicating it.

model Movie {
  id           String          @id @default(uuid())
  title        String
  posterUrl    String?
  genre        String
  rating       String // age rating, e.g. PG13
  synopsis     String?
  durationMins Int
  showtimes    MovieShowtime[]
  createdAt    DateTime        @default(now())
}

model MovieShowtime {
  id             String         @id @default(uuid())
  movieId        String
  movie          Movie          @relation(fields: [movieId], references: [id])
  cinema         String
  startsAt       DateTime
  price          Float
  seatsTotal     Int            @default(80)
  seatsAvailable Int            @default(80)
  bookings       MovieBooking[]
}

model MovieBooking {
  id         String        @id @default(uuid())
  showtimeId String
  showtime   MovieShowtime @relation(fields: [showtimeId], references: [id])
  userId     String
  user       User          @relation("entertainmentMovieBookings", fields: [userId], references: [id])
  seats      Int           @default(1)
  totalPrice Float
  status     String        @default("CONFIRMED")
  createdAt  DateTime      @default(now())
}

model Concert {
  id               String           @id @default(uuid())
  artist           String
  title            String
  genre            String
  venue            String
  city             String
  startsAt         DateTime
  posterUrl        String?
  price            Float
  ticketsTotal     Int              @default(500)
  ticketsAvailable Int              @default(500)
  bookings         ConcertBooking[]
  createdAt        DateTime         @default(now())
}

model ConcertBooking {
  id         String   @id @default(uuid())
  concertId  String
  concert    Concert  @relation(fields: [concertId], references: [id])
  userId     String
  user       User     @relation("entertainmentConcertBookings", fields: [userId], references: [id])
  tickets    Int      @default(1)
  totalPrice Float
  status     String   @default("CONFIRMED")
  createdAt  DateTime @default(now())
}

// Live Events are open, any-user-hosted (like Eat/Shopping) — organizerId is
// nullable so the platform-curated/seeded events keep working with no owner.
// An organizer can bring on co-managers (full edit rights, added by username
// or by sharing a manager invite code) and scanners (ticket check-in only,
// added the same two ways via a separate scanner invite code).
model EventListing {
  id                String         @id @default(uuid())
  organizerId       String?
  organizer         User?          @relation("eventOrganizer", fields: [organizerId], references: [id])
  title             String
  category          String // Comedy | Theatre | Sports | Festival
  venue             String
  city              String
  startsAt          DateTime
  posterUrl         String?
  description       String?
  price             Float
  ticketsTotal      Int            @default(300)
  ticketsAvailable  Int            @default(300)
  managerInviteCode String?        @unique
  scannerInviteCode String?        @unique
  bookings          EventBooking[]
  managers          EventManager[]
  scanners          EventScanner[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
}

model EventManager {
  id        String       @id @default(uuid())
  eventId   String
  event     EventListing @relation(fields: [eventId], references: [id])
  userId    String
  user      User         @relation("eventManagerships", fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([eventId, userId])
}

model EventScanner {
  id        String       @id @default(uuid())
  eventId   String
  event     EventListing @relation(fields: [eventId], references: [id])
  userId    String
  user      User         @relation("eventScannerships", fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@unique([eventId, userId])
}

model EventBooking {
  id          String        @id @default(uuid())
  eventId     String
  event       EventListing  @relation(fields: [eventId], references: [id])
  userId      String
  user        User          @relation("entertainmentEventBookings", fields: [userId], references: [id])
  tickets     Int           @default(1)
  totalPrice  Float
  status      String        @default("CONFIRMED")
  ticketItems EventTicket[]
  createdAt   DateTime      @default(now())
}

// One row per individual, independently scannable ticket — a booking of 3
// tickets creates 3 of these so friends can walk in separately.
model EventTicket {
  id          String       @id @default(uuid())
  bookingId   String
  booking     EventBooking @relation(fields: [bookingId], references: [id])
  code        String       @unique
  checkedIn   Boolean      @default(false)
  checkedInAt DateTime?
  checkedInBy String?
  createdAt   DateTime     @default(now())
}

// ============================================================
// Admin audit trail. adminId is nullable: the admin surface currently
// supports two auth modes (see admin/admin-access.guard.ts) — a per-user
// JWT from a User with role=ADMIN (adminId recorded), or the legacy shared
// ADMIN_API_KEY used by the website's ops dashboard today, which carries no
// individual identity (adminId left null, actorLabel records "shared-key").
// ============================================================
model AdminActionLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      User?    @relation(fields: [adminId], references: [id])
  actorLabel String // e.g. the admin's username, or "shared-key"
  action     String // e.g. "user.suspend", "feature-flag.set"
  targetType String? // e.g. "User", "FeatureFlag"
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([adminId])
}

