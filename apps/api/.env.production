# Production environment reference — NOT auto-loaded by the app.
#
# apps/api/src/env.ts always loads the plain `.env` file (local dev, points
# at self-hosted LiveKit). This file exists so production secrets have a
# single place to live in the repo instead of only in someone's head — when
# actually deploying, copy these into the hosting platform's environment
# variable dashboard/CLI (Railway, Fly.io, etc.), don't ship this file into
# the running container.
#
# Everything below only overrides what differs from dev. Values not listed
# here (DATABASE_URL, JWT_SECRET, BLOB_READ_WRITE_TOKEN, etc.) still need
# their own production equivalents set on the host before going live —
# reusing the dev ones would point production at the dev database/secrets.

# Guranda Live — LiveKit Cloud (guranda project)
LIVEKIT_HTTP_URL="https://guranda-07u7q4wm.livekit.cloud"
LIVEKIT_WS_URL="wss://guranda-07u7q4wm.livekit.cloud"
LIVEKIT_API_KEY="API9KVcTAjB2zVc"
LIVEKIT_API_SECRET="nENxoFPntVatZHiN17HEBVK0fOre9T7cvUtN1xWydgZ"
