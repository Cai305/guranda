# Loaded automatically by Expo for any build where NODE_ENV=production —
# which Gradle's release bundle task (bundleReleaseJsAndAssets) always sets.
# This is what makes `gradlew assembleRelease` point at the live backend
# without anyone having to remember to toggle .env by hand (see the
# postmortem comment in .env — that manual-toggle approach is exactly what
# shipped a build pointed at localhost).
EXPO_PUBLIC_API_BASE_URL=https://guranda.onrender.com
