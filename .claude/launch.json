    {
      "name": "website",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d C:\\Users\\USER\\Desktop\\website && npm run dev -- -p 3010"],
      "port": 3010
    }
  ]
}
