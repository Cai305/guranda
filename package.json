{
  "name": "mxit2.0-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "website"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "npm install --include=dev && npx turbo run build",
    "start": "node apps/api/dist/main",
    "start:prod": "node apps/api/dist/main"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "turbo": "^2.9.18"
  },
  "overrides": {
    "react-native-reanimated": "4.3.1",
    "react-native-worklets": "0.8.3"
  }
}
